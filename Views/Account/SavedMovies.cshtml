@model List<MovieWeb.Core.Models.Movie>
@{
    ViewData["Title"] = "Phim Đã Lưu - XemPhimOnline";
    ViewData["ActivePage"] = "SavedMovies";
}

<div class="main-wrapper" style="padding-top: 2rem; padding-bottom: 4rem;">
    <!-- Section Title & Badge -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--border-color);">
        <div>
            <h1 class="section-title mb-1" style="font-size: 2.2rem; font-weight: 800; color: #ffffff;">
                <i class="fas fa-bookmark text-warning me-2"></i> Danh Sách Phim Đã Lưu
            </h1>
            <p class="text-muted small mb-0">Quản lý và xem lại tất cả các bộ phim yêu thích bạn đã đánh dấu lưu.</p>
        </div>
        <div>
            <span class="badge-pill badge-warning" style="font-size: 0.95rem; padding: 8px 16px;">
                <i class="fas fa-film me-1.5"></i> @Model.Count phim
            </span>
        </div>
    </div>

    <!-- Saved Movies Display Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="movie-grid">
            @foreach (var movie in Model)
            {
                @await Html.PartialAsync("_MovieCard", movie)
            }
        </div>
    }
    else
    {
        <div class="text-center py-5" style="background: var(--bg-card); border-radius: var(--radius-md); border: 1px dashed rgba(255, 255, 255, 0.2); margin: 2rem 0;">
            <div class="mb-3">
                <i class="fas fa-bookmark text-warning" style="font-size: 4rem; opacity: 0.4;"></i>
            </div>
            <h3 class="text-white mb-2 fw-bold">Danh sách phim đã lưu đang trống</h3>
            <p class="text-muted mb-4" style="max-width: 480px; margin-left: auto; margin-right: auto;">
                Bạn chưa lưu bộ phim nào. Hãy nhấn vào nút <strong class="text-white"><i class="far fa-bookmark me-1"></i>Lưu Phim</strong> ở trang chi tiết phim để dễ dàng tìm và xem lại sau này!
            </p>
            <a href="/phim" class="btn-custom btn-primary-custom px-4 py-2.5">
                <i class="fas fa-film me-2"></i> Khám Phá Kho Phim Ngay
            </a>
        </div>
    }
</div>
