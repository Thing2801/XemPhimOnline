@model MovieWeb.Core.Models.Movie
@{
    ViewData["Title"] = $"{Model.Title} ({Model.ReleaseYear}) - MovieOnline";
    ViewData["ActivePage"] = "Movies";
    var relatedMovies = ViewBag.RelatedMovies as List<MovieWeb.Core.Models.Movie> ?? new List<MovieWeb.Core.Models.Movie>();
}

<!-- Movie Banner Detail Header -->
<section class="hero-slider-container" style="min-height: 55vh;">
    <img src="@Model.BannerUrl" class="hero-bg" alt="@Model.Title" />
    <div class="hero-overlay"></div>

    <div class="hero-content" style="padding-top: 5rem;">
        <div class="hero-text-side">
            <div class="hero-badges">
                <span class="badge-pill badge-gold"><i class="fas fa-star"></i> @Model.Rating</span>
                <span class="badge-pill badge-primary">@Model.Quality</span>
                <span class="badge-pill badge-glass">@Model.AgeRating</span>
                <span class="badge-pill badge-glass">@Model.Country</span>
                <span class="badge-pill badge-glass">@Model.Duration</span>
            </div>

            <h1 class="hero-title" style="font-size: 2.8rem;">@Model.Title</h1>
            <div class="hero-orig-title">@Model.OriginalTitle (@Model.ReleaseYear)</div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var gName in Model.GenreNames)
                {
                    <span class="badge-pill badge-glass"><i class="fas fa-tag"></i> @gName</span>
                }
            </div>

            <p class="hero-description">@Model.Description</p>

            <div class="hero-actions mt-4">
                <button class="btn-custom btn-primary-custom" onclick="document.getElementById('playerSection').scrollIntoView({behavior: 'smooth'})">
                    <i class="fas fa-play"></i> Xem Phim Ngay
                </button>
                <button class="btn-custom btn-glass-custom" onclick="playTrailerModal('@Model.TrailerUrl', '@Model.Title')">
                    <i class="fas fa-film"></i> Xem Trailer
                </button>
            </div>
        </div>

        <div class="hero-poster-card" style="width:280px; justify-self:center;">
            <img src="@Model.PosterUrl" class="hero-poster-img" style="height:390px;" alt="@Model.Title" />
        </div>
    </div>
</section>

<!-- Player Section & Details -->
<div class="main-wrapper">
    <div class="row g-4" id="playerSection">
        <!-- Video Player Block -->
        <div class="col-lg-8">
            <div class="card bg-card border-secondary-custom mb-4 style-card-player" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-md); overflow:hidden;">
                <div class="card-header p-3 d-flex align-items-center justify-content-between" style="border-bottom:1px solid var(--border-color)">
                    <div class="d-flex align-items-center gap-2 text-white font-weight-bold">
                        <i class="fas fa-play-circle text-danger"></i> Đang phát: <span class="text-white">@Model.Title</span>
                    </div>
                    <span class="badge-pill badge-primary">Server 4K High-Speed</span>
                </div>
                <div class="video-responsive">
                    <iframe src="@Model.TrailerUrl" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            </div>

            <!-- Cast & Info -->
            <div class="p-4" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-md);">
                <h3 class="text-white mb-3" style="font-size:1.3rem; font-weight:700;"><i class="fas fa-info-circle text-danger me-2"></i> Thông tin chi tiết</h3>

                <div class="row g-3" style="font-size:0.92rem;">
                    <div class="col-md-6">
                        <p class="text-muted mb-2.5"><strong class="text-white">Đạo diễn:</strong> @Model.Director</p>
                        <p class="text-muted mb-2.5"><strong class="text-white">Ngôn ngữ:</strong> @Model.LanguageMode</p>
                        <p class="text-muted mb-2.5"><strong class="text-white">Thời lượng:</strong> @Model.Duration</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-2.5"><strong class="text-white">Lượt xem:</strong> @(string.IsNullOrWhiteSpace(Model.ViewsText) ? Model.ViewsCount.ToString("N0") + " lượt" : (Model.ViewsText.Contains("lượt", StringComparison.OrdinalIgnoreCase) ? Model.ViewsText : Model.ViewsText + " lượt"))</p>
                        <p class="text-muted mb-2.5"><strong class="text-white">Phân loại:</strong> @Model.AgeRating</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr style="border-color:var(--border-color); margin:1.5rem 0;" />
                    <h4 class="text-white mb-2" style="font-size:1.1rem; font-weight:600;"><i class="fas fa-file-alt text-danger me-2"></i> Nội dung phim</h4>
                    <div class="movie-synopsis text-light" style="line-height:1.7; font-size:0.95rem; background: rgba(0,0,0,0.3); padding:1.2rem; border-radius:var(--radius-sm); border-left:4px solid var(--primary);">
                        @Html.Raw(Model.Description)
                    </div>
                }

                <!-- Rating & Comments Section -->
                <div class="rating-comments-container">
                    <div class="comments-header">
                        <h3 class="comments-title"><i class="fas fa-comments text-danger"></i> Đánh giá & Bình luận</h3>
                        <span class="comments-count-badge" id="commentCountBadge"><i class="fas fa-comment-dots text-danger me-1"></i> <span id="commentCountText">@(ViewBag.CommentsCount ?? 0)</span> bình luận</span>
                    </div>

                    @{
                        var realComments = ViewBag.Comments as List<MovieWeb.Core.Models.MovieComment> ?? new List<MovieWeb.Core.Models.MovieComment>();
                        int totalComments = ViewBag.CommentsCount != null ? (int)ViewBag.CommentsCount : realComments.Count;
                        var breakdown = ViewBag.RatingBreakdown as Dictionary<int, int> ?? new Dictionary<int, int> { {5,0},{4,0},{3,0},{2,0},{1,0} };
                        double displayRating = ViewBag.AverageRating != null ? (double)ViewBag.AverageRating : Model.Rating;
                    }

                    <!-- Rating Summary Box -->
                    <div class="rating-summary-box">
                        <div class="score-column">
                            <div class="big-score">@displayRating.ToString("0.0")</div>
                            <div class="star-row">
                                <i class="fas fa-star" style="color: #f5c518 !important;"></i>
                                <i class="fas fa-star" style="color: #f5c518 !important;"></i>
                                <i class="fas fa-star" style="color: #f5c518 !important;"></i>
                                <i class="fas fa-star" style="color: #f5c518 !important;"></i>
                                <i class="fas fa-star-half-alt" style="color: #f5c518 !important;"></i>
                            </div>
                            <div class="score-sub">Dựa trên @totalComments lượt đánh giá</div>
                        </div>
                        <div class="bars-column">
                            <div class="bar-row">
                                <span class="bar-label">5 sao</span>
                                <div class="bar-track"><div class="bar-fill" style="width: @(breakdown.ContainsKey(5) ? breakdown[5] : 0)%;"></div></div>
                                <span class="bar-percent">@(breakdown.ContainsKey(5) ? breakdown[5] : 0)%</span>
                            </div>
                            <div class="bar-row">
                                <span class="bar-label">4 sao</span>
                                <div class="bar-track"><div class="bar-fill" style="width: @(breakdown.ContainsKey(4) ? breakdown[4] : 0)%;"></div></div>
                                <span class="bar-percent">@(breakdown.ContainsKey(4) ? breakdown[4] : 0)%</span>
                            </div>
                            <div class="bar-row">
                                <span class="bar-label">3 sao</span>
                                <div class="bar-track"><div class="bar-fill" style="width: @(breakdown.ContainsKey(3) ? breakdown[3] : 0)%;"></div></div>
                                <span class="bar-percent">@(breakdown.ContainsKey(3) ? breakdown[3] : 0)%</span>
                            </div>
                            <div class="bar-row">
                                <span class="bar-label">2 & 1 sao</span>
                                <div class="bar-track"><div class="bar-fill" style="width: @((breakdown.ContainsKey(2) ? breakdown[2] : 0) + (breakdown.ContainsKey(1) ? breakdown[1] : 0))%;"></div></div>
                                <span class="bar-percent">@((breakdown.ContainsKey(2) ? breakdown[2] : 0) + (breakdown.ContainsKey(1) ? breakdown[1] : 0))%</span>
                            </div>
                        </div>
                    </div>

                    <!-- Add Comment Box -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="add-comment-box">
                            <div class="add-comment-header">
                                <span class="add-comment-title"><i class="fas fa-pen-alt text-danger me-1"></i> Viết đánh giá của bạn (@User.Identity.Name)</span>
                                <div class="star-rating-select" id="userStarRating">
                                    <i class="fas fa-star" data-rating="1" style="color: #f5c518 !important; cursor: pointer;"></i>
                                    <i class="fas fa-star" data-rating="2" style="color: #f5c518 !important; cursor: pointer;"></i>
                                    <i class="fas fa-star" data-rating="3" style="color: #f5c518 !important; cursor: pointer;"></i>
                                    <i class="fas fa-star" data-rating="4" style="color: #f5c518 !important; cursor: pointer;"></i>
                                    <i class="fas fa-star" data-rating="5" style="color: #f5c518 !important; cursor: pointer;"></i>
                                    <span class="rating-label-text" id="ratingText" style="color: #f5c518; font-weight: bold; margin-left: 8px;">(5 sao)</span>
                                </div>
                            </div>
                            <textarea id="commentText" class="comment-textarea-custom" rows="3" placeholder="Chia sẻ cảm nhận của bạn về bộ phim này... (Vui lòng không spoiler)"></textarea>
                            <div class="add-comment-footer">
                                <span class="civil-tip"><i class="fas fa-shield-alt text-success me-1"></i> Bình luận văn minh, tôn trọng người xem</span>
                                <button class="btn-submit-comment" onclick="postMovieComment('@Model.Id')">
                                    <i class="fas fa-paper-plane me-1"></i> Gửi Bình Luận
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="auth-required-box">
                            <div class="auth-box-icon">
                                <i class="fas fa-user-lock"></i>
                            </div>
                            <div class="auth-box-content">
                                <h4 class="auth-box-title">Tham gia cộng đồng xem phim</h4>
                                <p class="auth-box-desc">Đăng nhập ngay để viết đánh giá, gửi bình luận và chia sẻ cảm nhận của bạn về bộ phim này cùng mọi người!</p>
                                <div class="auth-box-buttons">
                                    <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)" class="auth-btn-primary">
                                        <i class="fas fa-sign-in-alt"></i> Đăng Nhập Ngay
                                    </a>
                                    <a href="/Account/Register?returnUrl=@Uri.EscapeDataString(Context.Request.Path)" class="auth-btn-secondary">
                                        <i class="fas fa-user-plus"></i> Tạo Tài Khoản Mới
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Comments List -->
                    <div class="comments-list-box" id="commentsContainer">
                        @if (!realComments.Any())
                        {
                            <div class="text-center py-4 text-muted" id="noCommentsNotice">
                                <i class="far fa-comment-dots fs-2 mb-2 d-block text-secondary"></i>
                                Chưa có bình luận nào cho bộ phim này. Hãy là người đầu tiên để lại ý kiến!
                            </div>
                        }
                        else
                        {
                            @foreach (var c in realComments)
                            {
                                <div class="comment-card" data-comment-id="@c.Id">
                                    <div class="comment-card-top">
                                        <div class="comment-user">
                                            <img src="@c.UserAvatar" class="comment-avatar" alt="Avatar" />
                                            <div class="comment-user-info">
                                                <div class="user-name">@c.UserName</div>
                                                <div class="comment-time">@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                            </div>
                                        </div>
                                        <div class="comment-stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= c.Rating)
                                                {
                                                    <i class="fas fa-star" style="color: #f5c518 !important;"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star" style="color: #444444 !important;"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <p class="comment-text">@c.Content</p>
                                    <div class="comment-actions">
                                        <button class="btn-like-comment" onclick="likeComment('@c.Id', this)">
                                            <i class="far fa-thumbs-up me-1"></i> <span class="like-count">@c.LikesCount</span> Thích
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <style>
                .rating-comments-container {
                    background: #1c1c1e;
                    border: 1px solid rgba(255, 255, 255, 0.12);
                    border-radius: 12px;
                    padding: 1.5rem;
                    margin-top: 1.5rem;
                    color: #e0e0e0;
                }
                .comments-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                    padding-bottom: 0.8rem;
                    margin-bottom: 1.2rem;
                }
                .comments-title {
                    color: #ffffff;
                    font-size: 1.25rem;
                    font-weight: 700;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }
                .comments-count-badge {
                    background: rgba(255, 255, 255, 0.08);
                    border: 1px solid rgba(255, 255, 255, 0.12);
                    color: #ffffff;
                    padding: 4px 12px;
                    border-radius: 20px;
                    font-size: 0.82rem;
                    font-weight: 600;
                }
                .rating-summary-box {
                    display: flex;
                    flex-wrap: wrap;
                    align-items: center;
                    background: rgba(0, 0, 0, 0.35);
                    border: 1px solid rgba(255, 255, 255, 0.08);
                    border-radius: 10px;
                    padding: 1.2rem;
                    margin-bottom: 1.5rem;
                    gap: 1.5rem;
                }
                .score-column {
                    text-align: center;
                    padding-right: 1.5rem;
                    border-right: 1px solid rgba(255, 255, 255, 0.1);
                    min-width: 150px;
                }
                .big-score {
                    font-size: 3rem;
                    font-weight: 800;
                    color: #f5c518;
                    line-height: 1;
                    margin-bottom: 4px;
                }
                .star-row i {
                    color: #f5c518 !important;
                    font-size: 0.95rem;
                }
                .score-sub {
                    font-size: 0.78rem;
                    color: #888888;
                    margin-top: 4px;
                }
                .bars-column {
                    flex: 1;
                    min-width: 220px;
                    display: flex;
                    flex-direction: column;
                    gap: 6px;
                }
                .bar-row {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    font-size: 0.82rem;
                }
                .bar-label {
                    width: 65px;
                    color: #aaaaaa;
                }
                .bar-track {
                    flex: 1;
                    height: 8px;
                    background: rgba(255, 255, 255, 0.1);
                    border-radius: 4px;
                    overflow: hidden;
                }
                .bar-fill {
                    height: 100%;
                    background: #f5c518;
                    border-radius: 4px;
                }
                .bar-percent {
                    width: 35px;
                    text-align: right;
                    color: #888888;
                }
                .add-comment-box {
                    background: rgba(0, 0, 0, 0.4);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    border-radius: 10px;
                    padding: 1.2rem;
                    margin-bottom: 1.5rem;
                }
                .add-comment-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 10px;
                }
                .add-comment-title {
                    color: #ffffff;
                    font-weight: 700;
                    font-size: 0.92rem;
                }
                .star-rating-select i {
                    color: #f5c518 !important;
                    font-size: 1.2rem;
                    cursor: pointer;
                    transition: transform 0.15s ease;
                }
                .star-rating-select i:hover {
                    transform: scale(1.25);
                }
                .comment-textarea-custom {
                    width: 100%;
                    background: #111113 !important;
                    border: 1px solid rgba(255, 255, 255, 0.15) !important;
                    color: #ffffff !important;
                    border-radius: 8px !important;
                    padding: 0.8rem 1rem !important;
                    font-size: 0.9rem !important;
                    outline: none !important;
                    resize: vertical;
                    box-shadow: none !important;
                    margin-bottom: 10px;
                    box-sizing: border-box;
                }
                .comment-textarea-custom:focus {
                    border-color: #e50914 !important;
                    box-shadow: 0 0 10px rgba(229, 9, 20, 0.3) !important;
                }
                .add-comment-footer {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    flex-wrap: wrap;
                    gap: 10px;
                }
                .civil-tip {
                    font-size: 0.8rem;
                    color: #888888;
                }
                .btn-submit-comment {
                    background: linear-gradient(135deg, #e50914 0%, #b20710 100%);
                    color: #ffffff;
                    font-weight: 700;
                    border: none;
                    padding: 8px 24px;
                    border-radius: 20px;
                    font-size: 0.86rem;
                    cursor: pointer;
                    transition: all 0.25s ease;
                    box-shadow: 0 4px 14px rgba(229, 9, 20, 0.4);
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }
                .btn-submit-comment:hover {
                    background: linear-gradient(135deg, #ff0f1a 0%, #d80712 100%);
                    color: #ffffff;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 18px rgba(229, 9, 20, 0.6);
                }
                .comments-list-box {
                    display: flex;
                    flex-direction: column;
                    gap: 1rem;
                }
                .comment-card {
                    background: rgba(255, 255, 255, 0.03);
                    border: 1px solid rgba(255, 255, 255, 0.07);
                    border-radius: 10px;
                    padding: 1rem 1.2rem;
                    transition: background 0.25s ease;
                }
                .comment-card:hover {
                    background: rgba(255, 255, 255, 0.06);
                }
                .comment-card-top {
                    display: flex;
                    justify-content: space-between;
                    align-items: flex-start;
                    margin-bottom: 8px;
                }
                .comment-user {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                }
                .comment-avatar {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    object-fit: cover;
                }
                .user-name {
                    color: #ffffff;
                    font-weight: 700;
                    font-size: 0.9rem;
                }
                .comment-time {
                    font-size: 0.75rem;
                    color: #777777;
                }
                .comment-stars i {
                    color: #f5c518 !important;
                    font-size: 0.85rem;
                }
                .comment-text {
                    color: #dddddd;
                    font-size: 0.88rem;
                    line-height: 1.5;
                    margin-bottom: 8px;
                }
                .comment-actions {
                    display: flex;
                    align-items: center;
                    gap: 15px;
                }
                .btn-like-comment {
                    background: transparent;
                    border: none;
                    color: #888888;
                    font-size: 0.78rem;
                    cursor: pointer;
                    padding: 0;
                    transition: color 0.2s ease;
                }
                .btn-like-comment:hover {
                    color: #ff333d;
                }
                </style>

                <script>
                var selectedRating = 5;
                document.addEventListener('DOMContentLoaded', function() {
                    var stars = document.querySelectorAll('#userStarRating i');
                    var ratingText = document.getElementById('ratingText');
                    
                    if (stars && stars.length) {
                        for (var i = 0; i < stars.length; i++) {
                            stars[i].addEventListener('mouseover', function() {
                                var r = parseInt(this.getAttribute('data-rating'));
                                highlightStars(r);
                            });
                            stars[i].addEventListener('mouseout', function() {
                                highlightStars(selectedRating);
                            });
                            stars[i].addEventListener('click', function() {
                                selectedRating = parseInt(this.getAttribute('data-rating'));
                                highlightStars(selectedRating);
                                if (ratingText) ratingText.innerText = '(' + selectedRating + ' sao)';
                            });
                        }
                    }

                    function highlightStars(r) {
                        for (var j = 0; j < stars.length; j++) {
                            stars[j].style.color = '#f5c518';
                            if (j < r) {
                                stars[j].style.opacity = '1';
                            } else {
                                stars[j].style.opacity = '0.35';
                            }
                        }
                    }
                    highlightStars(5);
                    if (ratingText) ratingText.innerText = '(5 sao)';
                });

                function postMovieComment(movieId) {
                    var commentInput = document.getElementById('commentText');
                    var txt = commentInput ? commentInput.value.trim() : '';
                    if (!txt) {
                        alert('Vui lòng nhập nội dung bình luận trước khi gửi.');
                        return;
                    }

                    fetch('/api/comments/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            movieId: movieId,
                            rating: selectedRating,
                            content: txt
                        })
                    })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        if (data.success && data.comment) {
                            var c = data.comment;
                            var container = document.getElementById('commentsContainer');
                            var noNotice = document.getElementById('noCommentsNotice');
                            if (noNotice) noNotice.remove();

                            var newComment = document.createElement('div');
                            newComment.className = 'comment-card';
                            newComment.style.cssText = 'background: rgba(229,9,20,0.1); border: 1px solid rgba(229,9,20,0.3);';

                            var starsHtml = '';
                            for (var i = 1; i <= 5; i++) {
                                if (i <= c.rating) {
                                    starsHtml += '<i class="fas fa-star" style="color:#f5c518 !important;"></i>';
                                } else {
                                    starsHtml += '<i class="far fa-star" style="color:#444444 !important;"></i>';
                                }
                            }

                            var commentContent = '<div class="comment-card-top">' +
                                '<div class="comment-user">' +
                                '<img src="' + c.userAvatar + '" class="comment-avatar" alt="Avatar" />' +
                                '<div class="comment-user-info">' +
                                '<div class="user-name">' + escapeHtml(c.userName) + '</div>' +
                                '<div class="comment-time">Vừa xong</div>' +
                                '</div>' +
                                '</div>' +
                                '<div class="comment-stars">' + starsHtml + '</div>' +
                                '</div>' +
                                '<p class="comment-text">' + escapeHtml(c.content) + '</p>' +
                                '<div class="comment-actions">' +
                                '<button class="btn-like-comment" onclick="likeComment(\'' + c.id + '\', this)"><i class="far fa-thumbs-up"></i> <span class="like-count">0</span> Thích</button>' +
                                '</div>';

                            newComment.innerHTML = commentContent;
                            if (container) {
                                container.insertBefore(newComment, container.firstChild);
                            }
                            if (commentInput) commentInput.value = '';

                            var badgeText = document.getElementById('commentCountText');
                            if (badgeText && data.totalCount) {
                                badgeText.innerText = data.totalCount;
                            }
                        } else {
                            alert(data.message || 'Đã có lỗi xảy ra khi gửi bình luận.');
                        }
                    })
                    .catch(function(err) {
                        alert('Lỗi kết nối máy chủ.');
                    });
                }

                function likeComment(commentId, btn) {
                    fetch('/api/comments/like', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ commentId: commentId })
                    })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        if (data.success) {
                            var likeSpan = btn.querySelector('.like-count');
                            if (likeSpan) likeSpan.innerText = data.likesCount;
                            btn.style.color = '#ff333d';
                        } else {
                            alert(data.message || 'Vui lòng đăng nhập để thích bình luận.');
                        }
                    });
                }

                function escapeHtml(text) {
                    return text.replace(/[&<>"']/g, function(m) {
                        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
                    });
                }
                </script>
            </div>
        </div>

        <!-- Sidebar Related Movies -->
        <div class="col-lg-4">
            <h3 class="section-title mb-3" style="font-size:1.3rem;">Phim Cùng Thể Loại</h3>
            <div class="d-flex flex-column gap-3">
                @foreach (var rel in relatedMovies)
                {
                    <a href="/phim/@rel.Id" class="search-result-item p-2" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-md);">
                        <img src="@rel.PosterUrl" class="search-result-img" style="width:65px; height:90px; border-radius:var(--radius-sm);" alt="@rel.Title" />
                        <div class="search-result-info">
                            <div class="search-result-title" style="font-size:0.95rem;">@rel.Title</div>
                            <div class="search-result-meta mb-1">@rel.OriginalTitle</div>
                            <div class="d-flex align-items-center gap-2" style="font-size:0.78rem;">
                                <span class="text-warning"><i class="fas fa-star"></i> @rel.Rating</span>
                                <span class="text-muted">• @rel.ReleaseYear</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
