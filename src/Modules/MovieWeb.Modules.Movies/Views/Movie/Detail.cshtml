    #notifyMovieModal .custom-modal-footer { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.25rem; }
    #notifyMovieModal .notify-input-field {
        width: 100%;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.15);
        color: #ffffff;
        border-radius: 10px;
        padding: 0.75rem 1rem;
