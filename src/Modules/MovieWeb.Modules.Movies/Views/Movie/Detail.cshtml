<script>
function selectPaymentOption(method) {
    var cardMomo = document.getElementById('optionCardMomo');
    var cardVnpay = document.getElementById('optionCardVnpay');
    var radioMomo = document.getElementById('radioMomo');
    var radioVnpay = document.getElementById('radioVnpay');

    if (method === 'momo') {
        if (radioMomo) radioMomo.checked = true;
        if (cardMomo) cardMomo.classList.add('active');
        if (cardVnpay) cardVnpay.classList.remove('active');
    } else {
        if (radioVnpay) radioVnpay.checked = true;
        if (cardVnpay) cardVnpay.classList.add('active');
        if (cardMomo) cardMomo.classList.remove('active');
    }
}
</script>

<script>
var _isUserAuthenticated = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false");

// Auto-detect payment success from MoMo redirect
(function() {
    var params = new URLSearchParams(window.location.search);
    if (params.get('payment') === 'success') {
        // Clean URL
        var cleanUrl = window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
        // Show success notification
        setTimeout(function() {
            if (typeof showCommentToast === 'function') {
                showCommentToast('success', '<i class="fas fa-check-circle text-success me-1"></i> Thanh toán thành công! Phim đã được mở khóa. Chúc bạn xem phim vui vẻ!');
            } else {
                alert('🎉 Thanh toán thành công! Phim đã được mở khóa.');
            }
        }, 500);
    }
})();

function openBuyMovieModal() {
    if (!_isUserAuthenticated) {
        if (typeof showCommentToast === 'function') {
            showCommentToast('danger', '<i class="fas fa-exclamation-circle text-danger me-1"></i> Vui lòng đăng nhập để mua vé xem phim!');
        } else {
            alert('Vui lòng đăng nhập để mua vé xem phim!');
        }
        setTimeout(function() { location.href = '/Account/Login?returnUrl=' + encodeURIComponent(location.pathname); }, 1200);
        return;
    }
    var modalEl = document.getElementById('buyMovieModal');
    if (!modalEl) {
        alert('Không tìm thấy modal thanh toán. Vui lòng tải lại trang.');
        return;
    }
    modalEl.style.display = 'flex';
    modalEl.classList.add('show');
    document.body.style.overflow = 'hidden';
}

function closeBuyMovieModal() {
    var modalEl = document.getElementById('buyMovieModal');
    if (modalEl) {
        modalEl.classList.remove('show');
        modalEl.style.display = 'none';
    }
    document.body.style.overflow = '';
}

function submitBuyMovie(movieId) {
    var btn = document.getElementById('btnSubmitBuyMovie');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1.5"></i> Đang chuyển đến MoMo...';
    }

    fetch('/api/movies/momo-create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ movieId: movieId })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
        if (data.success && data.payUrl) {
            // Redirect to MoMo payment page
            window.location.href = data.payUrl;
        } else {
            alert(data.message || 'Không thể tạo thanh toán MoMo. Vui lòng thử lại.');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle me-1.5"></i> Xác Nhận Thanh Toán';
            }
        }
    })
    .catch(function() {
        alert('Lỗi kết nối tới máy chủ.');
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check-circle me-1.5"></i> Xác Nhận Thanh Toán';
        }
    });
}

/* ---- Notify Coming Soon Movie Modal Functions ---- */
function openNotifyModal(movieId, movieTitle) {
    var modalEl = document.getElementById('notifyMovieModal');
    if (!modalEl) return;
    if (movieTitle) {
        var titleEl = document.getElementById('notifyModalMovieTitle');
        if (titleEl) titleEl.innerText = movieTitle;
    }
    modalEl.style.display = 'flex';
    modalEl.classList.add('show');
    document.body.style.overflow = 'hidden';
}

function closeNotifyModal() {
    var modalEl = document.getElementById('notifyMovieModal');
    if (modalEl) {
        modalEl.classList.remove('show');
        modalEl.style.display = 'none';
    }
    document.body.style.overflow = '';
}

function submitNotifyForm(e) {
    e.preventDefault();
    var name = document.getElementById('notifyName').value.trim();
    var email = document.getElementById('notifyEmail').value.trim();
    var btn = document.getElementById('btnSubmitNotify');

    if (!name || !email) {
        alert('Vui lòng nhập đầy đủ Họ tên và Email.');
        return;
    }

    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1.5"></i> Đang gửi dữ liệu...';
    }

    fetch('/api/movies/notify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            movieId: '@Model.Id',
            movieTitle: '@Model.Title',
            name: name,
            email: email
        })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
        closeNotifyModal();
        if (data.success) {
            try {
                var key = 'notify_movie_' + '@Model.Id';
                localStorage.setItem(key, JSON.stringify({ name: name, email: email, date: new Date().toISOString() }));
            } catch(err) {}

            if (typeof showCommentToast === 'function') {
                showCommentToast('success', '<i class="fas fa-check-circle text-success me-1"></i> ' + data.message);
            } else {
                alert(data.message);
            }
        } else {
            alert(data.message || 'Đăng ký nhận thông báo thất bại.');
        }
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane me-1.5"></i> Đăng Ký Nhận Tin';
        }
    })
    .catch(function() {
        alert('Lỗi kết nối tới hệ thống máy chủ.');
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane me-1.5"></i> Đăng Ký Nhận Tin';
        }
    });
}
</script>

<!-- Notify Coming Soon Movie Modal Overlay -->
