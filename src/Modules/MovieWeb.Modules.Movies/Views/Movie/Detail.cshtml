@model MovieWeb.Core.Models.Movie
@{
    ViewData["Title"] = $"{Model.Title} ({Model.ReleaseYear}) - MovieOnline";
    ViewData["ActivePage"] = "Movies";
    var relatedMovies = ViewBag.RelatedMovies as List<MovieWeb.Core.Models.Movie> ?? new List<MovieWeb.Core.Models.Movie>();
}

<!-- Movie Banner Detail Header -->
<section class="hero-slider-container" style="min-height: 55vh;">
    <img src="@Model.BannerUrl" class="hero-bg" alt="@Model.Title" />
    <div class="hero-overlay"></div>

    <div class="hero-content" style="padding-top: 5rem;">
        <div class="hero-text-side">
            <div class="hero-badges">
                @{
                    double headerRating = ViewBag.AverageRating != null && (double)ViewBag.AverageRating > 0 
                        ? (double)ViewBag.AverageRating 
                        : Model.Rating;
                    if (headerRating > 5.0)
                    {
                        while (headerRating > 5.0) { headerRating /= 2.0; }
                        headerRating = Math.Clamp(Math.Round(headerRating, 1), 1.0, 5.0);
                    }
                }
                @if (Model.IsComingSoon)
                {
                    <span class="badge-pill badge-gold"><i class="fas fa-calendar-alt me-1"></i> Sắp khởi chiếu</span>
                }
                else if (headerRating > 0)
                {
                    <span class="badge-pill badge-gold"><i class="fas fa-star"></i> @headerRating.ToString("0.0")</span>
                }
                else
                {
                    <span class="badge-pill badge-glass text-muted"><i class="far fa-star me-1"></i> Chưa có đánh giá</span>
                }
                <span class="badge-pill badge-primary">@Model.Quality</span>
                <span class="badge-pill badge-glass">@Model.AgeRating</span>
                <span class="badge-pill badge-glass">@Model.Country</span>
                <span class="badge-pill badge-glass">@Model.Duration</span>
                @if (Model.Price > 0)
                {
                    <span class="badge-pill badge-warning"><i class="fas fa-ticket-alt me-1"></i> Vé: @Model.FormattedPrice</span>
                }
                @if (Model.IsComingSoon && !string.IsNullOrWhiteSpace(Model.ComingShowDate))
                {
                    <span class="badge-pill badge-warning"><i class="fas fa-calendar-check me-1"></i> Khởi chiếu: @Model.ComingShowDate</span>
                }
            </div>

            <h1 class="hero-title" style="font-size: 2.8rem;">@Model.Title</h1>
            <div class="hero-orig-title">@Model.OriginalTitle (@Model.ReleaseYear)</div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var gName in Model.GenreNames)
                {
                    <span class="badge-pill badge-glass"><i class="fas fa-tag"></i> @gName</span>
                }
            </div>

            <p class="hero-description">@Model.Description</p>

            <div class="hero-actions mt-4">
                @{
                    bool isBookmarked = ViewBag.IsBookmarked as bool? ?? false;
                    bool isPurchased = ViewBag.IsPurchased as bool? ?? false;
                    // Phìm chiếu rạp chưa mua (không phụ thuộc vào Price hay IsNowShowing)
                    bool isCinemaUnlocked = Model.IsCinema && !Model.IsComingSoon && !isPurchased;
                }
                @if (Model.IsComingSoon)
                {
                    <button class="btn-custom btn-primary-custom" onclick="openNotifyModal('@Model.Id', '@Model.Title')">
                        <i class="fas fa-bell me-1.5"></i> Nhận Thông Báo
                    </button>
                    <button class="btn-custom btn-glass-custom" onclick="playTrailerModal('@Model.TrailerUrl', '@Model.Title')">
                        <i class="fas fa-film me-1.5"></i> Xem Trailer Phim
                    </button>
                }
                else if (isCinemaUnlocked)
                {
                    <button class="btn-custom btn-primary-custom" id="btnWatchNow" onclick="openBuyMovieModal()">
                        <i class="fas fa-play me-1.5"></i> Xem Phim Ngay@(Model.Price > 0 ? " (" + Model.FormattedPrice + ")" : "")
                    </button>
                    <button class="btn-custom btn-glass-custom" onclick="document.getElementById('playerSection').scrollIntoView({behavior: 'smooth'})">
                        <i class="fas fa-film me-1.5"></i> Xem Trailer Phim
                    </button>
                }
                else
                {
                    <button class="btn-custom btn-primary-custom" onclick="document.getElementById('playerSection').scrollIntoView({behavior: 'smooth'})">
                        <i class="fas fa-play me-1.5"></i> Xem Phim Ngay
                    </button>
                    <button class="btn-custom btn-glass-custom" onclick="playTrailerModal('@Model.TrailerUrl', '@Model.Title')">
                        <i class="fas fa-film me-1.5"></i> Xem Trailer
                    </button>
                }
                <button class="btn-custom @(isBookmarked ? "btn-warning-custom" : "btn-glass-custom")" id="btnBookmarkDetail" onclick="toggleBookmark('@Model.Id')">
                    <i class="@(isBookmarked ? "fas" : "far") fa-bookmark me-1.5" id="bookmarkIcon"></i>
                    <span id="bookmarkText">@(isBookmarked ? "Đã Lưu Phim" : "Lưu Phim")</span>
                </button>
            </div>
        </div>

        <div class="hero-poster-card position-relative" style="width:280px; justify-self:center;">
            <img src="@Model.PosterUrl" class="hero-poster-img" style="height:390px;" alt="@Model.Title" />
            @if (Model.Price > 0)
            {
                <div class="position-absolute top-0 start-0 m-3 px-3 py-1.5 rounded-pill text-dark fw-bold shadow-lg d-flex align-items-center gap-1.5"
                     style="background: linear-gradient(135deg, #f59e0b, #fbbf24); font-size: 0.9rem; z-index: 4; border: 1px solid rgba(255,255,255,0.6); box-shadow: 0 4px 15px rgba(245,158,11,0.5);">
                    <i class="fas fa-ticket-alt"></i> Vé: @Model.FormattedPrice
                </div>
            }
        </div>
    </div>
</section>

<!-- Player Section & Details -->
<div class="main-wrapper">
    <div class="row g-4" id="playerSection">
        <!-- Video Player Block -->
        <div class="col-lg-8">
            <div class="card bg-card border-secondary-custom mb-4 style-card-player" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-md); overflow:hidden;">
                <div class="card-header p-3 d-flex align-items-center justify-content-between" style="border-bottom:1px solid var(--border-color)">
                    <div class="d-flex align-items-center gap-2 text-white font-weight-bold">
                        <i class="fas fa-play-circle text-danger"></i> @(Model.IsComingSoon ? "Trailer phim:" : (isCinemaUnlocked ? "Trailer xem trước (Phim có phí):" : "Đang phát:")) <span class="text-white">@Model.Title</span>
                    </div>
                    <span class="badge-pill @(Model.IsComingSoon ? "badge-warning" : (isCinemaUnlocked ? "badge-warning" : "badge-primary"))">
                        @(Model.IsComingSoon ? "Sắp Khởi Chiếu" : (isCinemaUnlocked ? $"Vé: {Model.FormattedPrice}" : "Server 4K High-Speed"))
                    </span>
                </div>
                @if (isCinemaUnlocked)
                {
                    <div class="p-3 bg-dark-subtle border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2" style="background: rgba(245,158,11,0.12) !important; border-color: rgba(245,158,11,0.25) !important;">
                        <div class="text-warning small d-flex align-items-center gap-2">
                            <i class="fas fa-film fs-5"></i>
                            <div>
                                <div class="fw-bold text-white">Đang phát trailer xem trước của phim chiếu rạp</div>
                                <div class="text-warning-subtle" style="font-size:0.78rem;">Bạn cần mua vé để xem bản chiếu HD/4K đầy đủ.</div>
                            </div>
                        </div>
                        <button class="btn-custom btn-warning-custom py-1.5 px-3" style="font-size:0.85rem;" onclick="openBuyMovieModal()">
                            <i class="fas fa-ticket-alt me-1.5"></i> Mua vé mở khóa phim (@Model.FormattedPrice)
                        </button>
                    </div>
                }
                <div class="video-responsive" style="position:relative;">
                    @if (Model.IsComingSoon)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 w-100 p-4 text-center"
                             style="position:absolute; inset:0; background: linear-gradient(135deg, rgba(18,18,18,0.96), rgba(35,20,20,0.96)); z-index:5;">
                            <div class="mb-3" style="width:70px; height:70px; border-radius:50%; background:rgba(234, 179, 8, 0.15); display:flex; align-items:center; justify-content:center;">
                                <i class="fas fa-calendar-alt text-warning" style="font-size:2.2rem;"></i>
                            </div>
                            <h3 class="text-white fw-bold mb-2">Phim Chiếu Rạp Sắp Công Chiếu</h3>
                            <p class="text-muted mb-4" style="max-width:460px; font-size:0.95rem; line-height:1.6;">
                                Phim hiện chưa chính thức khởi chiếu tại các rạp phim.
                                @if (!string.IsNullOrWhiteSpace(Model.ComingShowDate))
                                {
                                    <span class="d-block text-warning fw-bold my-1" style="font-size:1.05rem;">
                                        <i class="far fa-calendar-alt me-1"></i> Ngày khởi chiếu: @Model.ComingShowDate
                                    </span>
                                }
                                Bạn có thể thưởng thức ngay đoạn <strong class="text-white">Trailer xem trước</strong> trong lúc chờ đợi!
                            </p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <button class="btn-custom btn-primary-custom px-4 py-2.5" onclick="openNotifyModal('@Model.Id', '@Model.Title')">
                                    <i class="fas fa-bell me-2"></i> Nhận Thông Báo
                                </button>
                                <button class="btn-custom btn-glass-custom px-4 py-2.5" onclick="playTrailerModal('@Model.TrailerUrl', '@Model.Title')">
                                    <i class="fas fa-film me-2"></i> Xem Trailer Ngay
                                </button>
                            </div>
                        </div>
                    }
                    <iframe src="@Model.TrailerUrl" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            </div>

            <!-- Cast & Info -->
            <div class="p-4" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-md);">
                <h3 class="text-white mb-3" style="font-size:1.3rem; font-weight:700;"><i class="fas fa-info-circle text-danger me-2"></i> Thông tin chi tiết</h3>

                <div class="row g-3" style="font-size:0.92rem;">
                    <div class="col-md-6">
                        <p class="text-muted mb-2.5"><strong class="text-white">Đạo diễn:</strong> @Model.Director</p>
                        <p class="text-muted mb-2.5"><strong class="text-white">Ngôn ngữ:</strong> @Model.LanguageMode</p>
                        <p class="text-muted mb-2.5"><strong class="text-white">Thời lượng:</strong> @Model.Duration</p>
                        @if (!string.IsNullOrWhiteSpace(Model.ComingShowDate))
                        {
                            <p class="text-muted mb-2.5"><strong class="text-warning">Lịch khởi chiếu:</strong> <span class="text-warning fw-bold">@Model.ComingShowDate</span></p>
                        }
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-2.5"><strong class="text-white">Lượt xem:</strong> @(string.IsNullOrWhiteSpace(Model.ViewsText) ? Model.ViewsCount.ToString("N0") + " lượt" : (Model.ViewsText.Contains("lượt", StringComparison.OrdinalIgnoreCase) ? Model.ViewsText : Model.ViewsText + " lượt"))</p>
                        <p class="text-muted mb-2.5"><strong class="text-white">Phân loại:</strong> @Model.AgeRating</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr style="border-color:var(--border-color); margin:1.5rem 0;" />
                    <h4 class="text-white mb-2" style="font-size:1.1rem; font-weight:600;"><i class="fas fa-file-alt text-danger me-2"></i> Nội dung phim</h4>
                    <div class="movie-synopsis text-light" style="line-height:1.7; font-size:0.95rem; background: rgba(0,0,0,0.3); padding:1.2rem; border-radius:var(--radius-sm); border-left:4px solid var(--primary);">
                        @Html.Raw(Model.Description)
                    </div>
                }
            </div>

            <!-- Rating & Comments Section -->
            <div class="rating-comments-container">
                <div class="comments-header">
                    <h3 class="comments-title"><i class="fas fa-comments text-danger"></i> Đánh giá & Bình luận</h3>
                    <span class="comments-count-badge" id="commentCountBadge"><i class="fas fa-comment-dots text-danger me-1"></i> <span id="commentCountText">@(ViewBag.CommentsCount ?? 0)</span> bình luận</span>
                </div>

                @{
                    var realComments = ViewBag.Comments as List<MovieWeb.Core.Models.MovieComment> ?? new List<MovieWeb.Core.Models.MovieComment>();
                    var topLevelComments = realComments.Where(c => string.IsNullOrEmpty(c.ParentId)).OrderByDescending(c => c.CreatedAt).ToList();
                    int totalRatingsCount = topLevelComments.Count(c => c.Rating > 0);
                    var breakdown = ViewBag.RatingBreakdown as Dictionary<int, int> ?? new Dictionary<int, int> { {5,0},{4,0},{3,0},{2,0},{1,0} };
                    double displayRating = ViewBag.AverageRating != null ? (double)ViewBag.AverageRating : 0.0;
                }

                <!-- Rating Summary Box -->
                <div class="rating-summary-box">
                    <div class="score-column">
                        @if (totalRatingsCount > 0 || displayRating > 0)
                        {
                            <div class="big-score">@displayRating.ToString("0.0")</div>
                            <div class="star-row">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (displayRating >= i)
                                    {
                                        <i class="fas fa-star" style="color: #f5c518 !important;"></i>
                                    }
                                    else if (displayRating >= i - 0.5)
                                    {
                                        <i class="fas fa-star-half-alt" style="color: #f5c518 !important;"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star" style="color: #444444 !important;"></i>
                                    }
                                }
                            </div>
                            <div class="score-sub">Dựa trên @totalRatingsCount lượt đánh giá</div>
                        }
                        else
                        {
                            <div class="big-score text-muted" style="font-size: 1.8rem; opacity: 0.7;">N/A</div>
                            <div class="star-row text-muted" style="font-size: 0.9rem; margin-top: 4px;">
                                <i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i>
                            </div>
                            <div class="score-sub">Chưa có lượt đánh giá nào</div>
                        }
                    </div>
                    <div class="bars-column">
                        <div class="bar-row">
                            <span class="bar-label">5 sao</span>
                            <div class="bar-track"><div class="bar-fill" style="width: @(breakdown.ContainsKey(5) ? breakdown[5] : 0)%;"></div></div>
                            <span class="bar-percent">@(breakdown.ContainsKey(5) ? breakdown[5] : 0)%</span>
                        </div>
                        <div class="bar-row">
                            <span class="bar-label">4 sao</span>
                            <div class="bar-track"><div class="bar-fill" style="width: @(breakdown.ContainsKey(4) ? breakdown[4] : 0)%;"></div></div>
                            <span class="bar-percent">@(breakdown.ContainsKey(4) ? breakdown[4] : 0)%</span>
                        </div>
                        <div class="bar-row">
                            <span class="bar-label">3 sao</span>
                            <div class="bar-track"><div class="bar-fill" style="width: @(breakdown.ContainsKey(3) ? breakdown[3] : 0)%;"></div></div>
                            <span class="bar-percent">@(breakdown.ContainsKey(3) ? breakdown[3] : 0)%</span>
                        </div>
                        <div class="bar-row">
                            <span class="bar-label">2 & 1 sao</span>
                            <div class="bar-track"><div class="bar-fill" style="width: @((breakdown.ContainsKey(2) ? breakdown[2] : 0) + (breakdown.ContainsKey(1) ? breakdown[1] : 0))%;"></div></div>
                            <span class="bar-percent">@((breakdown.ContainsKey(2) ? breakdown[2] : 0) + (breakdown.ContainsKey(1) ? breakdown[1] : 0))%</span>
                        </div>
                    </div>
                </div>

                <!-- Add Comment Box -->
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="add-comment-box">
                        <div class="add-comment-header">
                            <span class="add-comment-title"><i class="fas fa-pen-alt text-danger me-1"></i> Viết đánh giá của bạn (@User.Identity.Name)</span>
                            <div class="star-rating-select" id="userStarRating">
                                <i class="fas fa-star" data-rating="1" style="color: #f5c518 !important; cursor: pointer;"></i>
                                <i class="fas fa-star" data-rating="2" style="color: #f5c518 !important; cursor: pointer;"></i>
                                <i class="fas fa-star" data-rating="3" style="color: #f5c518 !important; cursor: pointer;"></i>
                                <i class="fas fa-star" data-rating="4" style="color: #f5c518 !important; cursor: pointer;"></i>
                                <i class="fas fa-star" data-rating="5" style="color: #f5c518 !important; cursor: pointer;"></i>
                                <span class="rating-label-text" id="ratingText" style="color: #f5c518; font-weight: bold; margin-left: 8px;">(5 sao)</span>
                            </div>
                        </div>
                        <textarea id="commentText" class="comment-textarea-custom" rows="3" placeholder="Chia sẻ cảm nhận của bạn về bộ phim này... (Vui lòng không spoiler)"></textarea>
                        <div class="add-comment-footer">
                            <span class="civil-tip"><i class="fas fa-shield-alt text-success me-1"></i> Bình luận văn minh, tôn trọng người xem</span>
                            <button class="btn-submit-comment" onclick="postMovieComment('@Model.Id')">
                                <i class="fas fa-paper-plane me-1"></i> Gửi Bình Luận
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="auth-required-box">
                        <div class="auth-box-icon">
                            <i class="fas fa-user-lock"></i>
                        </div>
                        <div class="auth-box-content">
                            <h4 class="auth-box-title">Tham gia cộng đồng xem phim</h4>
                            <p class="auth-box-desc">Đăng nhập ngay để viết đánh giá, gửi bình luận và chia sẻ cảm nhận của bạn về bộ phim này cùng mọi người!</p>
                            <div class="auth-box-buttons">
                                <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)" class="auth-btn-primary">
                                    <i class="fas fa-sign-in-alt"></i> Đăng Nhập Ngay
                                </a>
                                <a href="/Account/Register?returnUrl=@Uri.EscapeDataString(Context.Request.Path)" class="auth-btn-secondary">
                                    <i class="fas fa-user-plus"></i> Tạo Tài Khoản Mới
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Comments List -->
                <div class="comments-list-box" id="commentsContainer">
                    @if (!topLevelComments.Any())
                    {
                        <div class="text-center py-4 text-muted" id="noCommentsNotice">
                            <i class="far fa-comment-dots fs-2 mb-2 d-block text-secondary"></i>
                            Chưa có bình luận nào cho bộ phim này. Hãy là người đầu tiên để lại ý kiến!
                        </div>
                    }
                    else
                    {
                        foreach (var c in topLevelComments)
                        {
                            var childReplies = realComments.Where(r => r.ParentId == c.Id).OrderBy(r => r.CreatedAt).ToList();

                            <div class="comment-card parent-comment-card" data-comment-id="@c.Id" data-content="@c.Content" data-rating="@c.Rating" data-user-id="@c.UserId">
                                <div class="comment-card-top">
                                    <div class="comment-user">
                                        <img src="@c.UserAvatar" class="comment-avatar" alt="Avatar" />
                                        <div class="comment-user-info">
                                            <div class="user-name">@c.UserName</div>
                                            <div class="comment-time">@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="comment-stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= c.Rating)
                                                {
                                                    <i class="fas fa-star" style="color: #f5c518 !important;"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star" style="color: #444444 !important;"></i>
                                                }
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(ViewBag.CurrentUserId as string) && c.UserId == (string)ViewBag.CurrentUserId)
                                        {
                                            <div class="comment-owner-actions">
                                                <button class="btn-comment-action btn-edit-comment" title="Chỉnh sửa" onclick="openEditModal('@c.Id', this)">
                                                    <i class="fas fa-pen"></i>
                                                </button>
                                                <button class="btn-comment-action btn-delete-comment" title="Xóa bình luận" onclick="deleteComment('@c.Id', this)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <p class="comment-text" id="comment-text-@c.Id">@c.Content</p>
                                <div class="comment-actions d-flex align-items-center gap-2">
                                    <button class="btn-like-comment" onclick="likeComment('@c.Id', this)">
                                        <i class="far fa-thumbs-up me-1"></i> <span class="like-count">@c.LikesCount</span> Thích
                                    </button>
                                    <button class="btn-reply-comment" onclick="toggleReplyBox('@c.Id', '@c.Id', '@c.UserId', '@c.UserName', this)">
                                        <i class="far fa-comment-dots me-1"></i> Trả lời
                                    </button>
                                </div>

                                <!-- Inline Reply Form for Parent Comment -->
                                <div class="inline-reply-box" id="reply-box-@c.Id" style="display: none;">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="small text-secondary"><i class="fas fa-reply text-danger me-1"></i> Đang trả lời <strong class="text-white">@c.UserName</strong></span>
                                        <button type="button" class="btn-close-reply" onclick="closeReplyBox('@c.Id')">&times;</button>
                                    </div>
                                    <textarea id="replyText-@c.Id" class="comment-textarea-custom mb-2" rows="2" placeholder="Nhập câu trả lời của bạn..."></textarea>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-sm btn-outline-secondary text-white" onclick="closeReplyBox('@c.Id')">Hủy</button>
                                        <button class="btn btn-sm btn-danger" onclick="postCommentReply('@Model.Id', '@c.Id', '@c.UserId', '@c.UserName', '@c.Id')">
                                            <i class="fas fa-paper-plane me-1"></i> Gửi Trả Lời
                                        </button>
                                    </div>
                                </div>

                                <!-- Child Replies Container (Nested with Indentation) -->
                                <div class="comment-replies-container" id="replies-container-@c.Id" style="@(childReplies.Any() ? "" : "display:none;")">
                                    @foreach (var r in childReplies)
                                    {
                                        <div class="comment-card child-comment-card" data-comment-id="@r.Id" data-content="@r.Content" data-rating="@r.Rating" data-user-id="@r.UserId">
                                            <div class="comment-card-top">
                                                <div class="comment-user">
                                                    <img src="@r.UserAvatar" class="comment-avatar" alt="Avatar" />
                                                    <div class="comment-user-info">
                                                        <div class="user-name">
                                                            @r.UserName
                                                            @if (!string.IsNullOrEmpty(r.ReplyToUserName))
                                                            {
                                                                <span class="reply-arrow-symbol">&gt;</span>
                                                                <span class="reply-target-name">@r.ReplyToUserName</span>
                                                            }
                                                        </div>
                                                        <div class="comment-time">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(ViewBag.CurrentUserId as string) && r.UserId == (string)ViewBag.CurrentUserId)
                                                    {
                                                        <div class="comment-owner-actions">
                                                            <button class="btn-comment-action btn-edit-comment" title="Chỉnh sửa" onclick="openEditModal('@r.Id', this)">
                                                                <i class="fas fa-pen"></i>
                                                            </button>
                                                            <button class="btn-comment-action btn-delete-comment" title="Xóa bình luận" onclick="deleteComment('@r.Id', this)">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <p class="comment-text" id="comment-text-@r.Id">@r.Content</p>
                                            <div class="comment-actions d-flex align-items-center gap-2">
                                                <button class="btn-like-comment" onclick="likeComment('@r.Id', this)">
                                                    <i class="far fa-thumbs-up me-1"></i> <span class="like-count">@r.LikesCount</span> Thích
                                                </button>
                                                <button class="btn-reply-comment" onclick="toggleReplyBox('@r.Id', '@c.Id', '@r.UserId', '@r.UserName', this)">
                                                    <i class="far fa-comment-dots me-1"></i> Trả lời
                                                </button>
                                            </div>

                                            <!-- Inline Reply Form for Child Comment -->
                                            <div class="inline-reply-box" id="reply-box-@r.Id" style="display: none;">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="small text-secondary"><i class="fas fa-reply text-danger me-1"></i> Đang trả lời <strong class="text-white">@r.UserName</strong></span>
                                                    <button type="button" class="btn-close-reply" onclick="closeReplyBox('@r.Id')">&times;</button>
                                                </div>
                                                <textarea id="replyText-@r.Id" class="comment-textarea-custom mb-2" rows="2" placeholder="Nhập câu trả lời của bạn..."></textarea>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button class="btn btn-sm btn-outline-secondary text-white" onclick="closeReplyBox('@r.Id')">Hủy</button>
                                                    <button class="btn btn-sm btn-danger" onclick="postCommentReply('@Model.Id', '@c.Id', '@r.UserId', '@r.UserName', '@r.Id')">
                                                        <i class="fas fa-paper-plane me-1"></i> Gửi Trả Lời
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
