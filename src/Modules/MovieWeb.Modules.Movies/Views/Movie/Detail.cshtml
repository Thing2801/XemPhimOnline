            <script>
            var selectedRating = 5;
            var currentUserId = '@Html.Raw(ViewBag.CurrentUserId ?? "")';

            document.addEventListener('DOMContentLoaded', function() {
                var stars = document.querySelectorAll('#userStarRating i');
                var ratingText = document.getElementById('ratingText');
                
                if (stars && stars.length) {
                    for (var i = 0; i < stars.length; i++) {
                        stars[i].addEventListener('mouseover', function() {
                            var r = parseInt(this.getAttribute('data-rating'));
                            highlightStars(r);
                        });
                        stars[i].addEventListener('mouseout', function() {
                            highlightStars(selectedRating);
                        });
                        stars[i].addEventListener('click', function() {
                            selectedRating = parseInt(this.getAttribute('data-rating'));
                            highlightStars(selectedRating);
                            if (ratingText) ratingText.innerText = '(' + selectedRating + ' sao)';
                        });
                    }
                }

                function highlightStars(r) {
                    for (var j = 0; j < stars.length; j++) {
                        stars[j].style.color = '#f5c518';
                        if (j < r) {
                            stars[j].style.opacity = '1';
                        } else {
                            stars[j].style.opacity = '0.35';
                        }
                    }
                }
                highlightStars(5);
                if (ratingText) ratingText.innerText = '(5 sao)';
            });

            function postMovieComment(movieId) {
                var commentInput = document.getElementById('commentText');
                var txt = commentInput ? commentInput.value.trim() : '';
                if (!txt) {
                    alert('Vui lòng nhập nội dung bình luận trước khi gửi.');
                    return;
                }

                fetch('/api/comments/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        movieId: movieId,
                        rating: selectedRating,
                        content: txt
                    })
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success && data.comment) {
                        var c = data.comment;
                        var container = document.getElementById('commentsContainer');
                        var noNotice = document.getElementById('noCommentsNotice');
                        if (noNotice) noNotice.remove();

                        var newComment = document.createElement('div');
                        newComment.className = 'comment-card';
                        newComment.style.cssText = 'background: rgba(229,9,20,0.1); border: 1px solid rgba(229,9,20,0.3);';
                        newComment.setAttribute('data-comment-id', c.id);
                        newComment.setAttribute('data-content', c.content);
                        newComment.setAttribute('data-rating', c.rating);

                        var starsHtml = '';
                        for (var i = 1; i <= 5; i++) {
                            if (i <= c.rating) {
                                starsHtml += '<i class="fas fa-star" style="color:#f5c518 !important;"></i>';
                            } else {
                                starsHtml += '<i class="far fa-star" style="color:#444444 !important;"></i>';
                            }
                        }

                        var ownerActionsHtml = '';
                        if (currentUserId && c.userId === currentUserId) {
                            ownerActionsHtml = '<div class="comment-owner-actions">' +
                                '<button class="btn-comment-action btn-edit-comment" title="Chỉnh sửa" onclick="openEditModal(\'' + c.id + '\', this)"><i class="fas fa-pen"></i></button>' +
                                '<button class="btn-comment-action btn-delete-comment" title="Xóa bình luận" onclick="deleteComment(\'' + c.id + '\', this)"><i class="fas fa-trash"></i></button>' +
                                '</div>';
                        }

                        var commentContent = '<div class="comment-card-top">' +
                            '<div class="comment-user">' +
                            '<img src="' + c.userAvatar + '" class="comment-avatar" alt="Avatar" />' +
                            '<div class="comment-user-info">' +
                            '<div class="user-name">' + escapeHtml(c.userName) + '</div>' +
                            '<div class="comment-time">Vừa xong</div>' +
                            '</div>' +
                            '</div>' +
                            '<div class="d-flex align-items-center gap-2">' +
                            '<div class="comment-stars">' + starsHtml + '</div>' +
                            ownerActionsHtml +
                            '</div>' +
                            '</div>' +
                            '<p class="comment-text" id="comment-text-' + c.id + '">' + escapeHtml(c.content) + '</p>' +
                            '<div class="comment-actions">' +
                            '<button class="btn-like-comment" onclick="likeComment(\'' + c.id + '\', this)"><i class="far fa-thumbs-up"></i> <span class="like-count">0</span> Thích</button>' +
                            '</div>';

                        newComment.innerHTML = commentContent;
                        if (container) {
                            container.insertBefore(newComment, container.firstChild);
                        }
                        if (commentInput) commentInput.value = '';

                        var badgeText = document.getElementById('commentCountText');
                        if (badgeText && data.totalCount) {
                            badgeText.innerText = data.totalCount;
                        }
                    } else {
                        alert(data.message || 'Đã có lỗi xảy ra khi gửi bình luận.');
                    }
                })
                .catch(function(err) {
                    alert('Lỗi kết nối máy chủ.');
                });
            }

            function likeComment(commentId, btn) {
                fetch('/api/comments/like', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ commentId: commentId })
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success) {
                        var likeSpan = btn.querySelector('.like-count');
                        if (likeSpan) likeSpan.innerText = data.likesCount;
                        btn.style.color = '#ff333d';
                    } else {
                        alert(data.message || 'Vui lòng đăng nhập để thích bình luận.');
                    }
                });
            }

            function escapeHtml(text) {
                return text.replace(/[&<>"']/g, function(m) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
                });
            }

            // ---- Delete Comment ----
            function deleteComment(commentId, btn) {
                if (!confirm('Bạn có chắc muốn xóa bình luận này không?')) return;
                var card = document.querySelector('[data-comment-id="' + commentId + '"]');
                fetch('/api/comments/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ commentId: commentId })
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success) {
                        if (card) {
                            card.classList.add('deleting');
                            setTimeout(function() { card.remove(); }, 360);
                        }
                        showCommentToast('success', '<i class="fas fa-trash-alt me-2"></i>Đã xóa bình luận thành công.');
                        var badge = document.getElementById('commentCountText');
                        if (badge) badge.innerText = Math.max(0, parseInt(badge.innerText || '0') - 1);
                    } else {
                        showCommentToast('error', '<i class="fas fa-exclamation-circle me-2"></i>' + (data.message || 'Không thể xóa bình luận.'));
                    }
                })
                .catch(function() {
                    showCommentToast('error', '<i class="fas fa-exclamation-circle me-2"></i>Lỗi kết nối máy chủ.');
                });
            }

            // ---- Edit Modal ----
            var _editCommentId = null;
            var _editRating = 5;

            function openEditModal(commentId, btn) {
                _editCommentId = commentId;
                var card = document.querySelector('[data-comment-id="' + commentId + '"]');
                var content = card ? (card.getAttribute('data-content') || '') : '';
                var rating = card ? parseInt(card.getAttribute('data-rating') || '5') : 5;
                _editRating = rating;

                var textarea = document.getElementById('editCommentText');
                if (textarea) textarea.value = content;
                highlightEditStars(rating);

                var modal = document.getElementById('editCommentModal');
                if (modal) modal.style.display = 'flex';
                if (textarea) setTimeout(function() { textarea.focus(); }, 100);
            }

            function closeEditModal(e) {
                if (e && e.target !== document.getElementById('editCommentModal')) return;
                var modal = document.getElementById('editCommentModal');
                if (modal) modal.style.display = 'none';
            }

            function submitEditComment() {
                if (!_editCommentId) return;
                var textarea = document.getElementById('editCommentText');
                var content = textarea ? textarea.value.trim() : '';
                if (!content) {
                    showCommentToast('error', '<i class="fas fa-exclamation-circle me-2"></i>Vui lòng nhập nội dung bình luận.');
                    return;
            }
                fetch('/api/comments/edit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ commentId: _editCommentId, content: content, rating: _editRating })
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success) {
                        var card = document.querySelector('[data-comment-id="' + _editCommentId + '"]');
                        if (card) {
                            card.setAttribute('data-content', content);
                            card.setAttribute('data-rating', _editRating);
                            var textEl = document.getElementById('comment-text-' + _editCommentId);
                            if (textEl) textEl.innerText = content;
                            // Update stars in the card
                            var starsContainer = card.querySelector('.comment-stars');
                            if (starsContainer) {
                                var starsHtml = '';
                                for (var i = 1; i <= 5; i++) {
                                    starsHtml += i <= _editRating
                                        ? '<i class="fas fa-star" style="color:#f5c518 !important;"></i>'
                                        : '<i class="far fa-star" style="color:#444444 !important;"></i>';
                                }
                                starsContainer.innerHTML = starsHtml;
                            }
                        }
                        var modal = document.getElementById('editCommentModal');
                        if (modal) modal.style.display = 'none';
                        showCommentToast('success', '<i class="fas fa-check-circle me-2"></i>Đã cập nhật bình luận.');
                    } else {
                        showCommentToast('error', '<i class="fas fa-exclamation-circle me-2"></i>' + (data.message || 'Không thể cập nhật bình luận.'));
                    }
                })
                .catch(function() {
                    showCommentToast('error', '<i class="fas fa-exclamation-circle me-2"></i>Lỗi kết nối máy chủ.');
                });
            }

            // Edit modal star setup
            document.addEventListener('DOMContentLoaded', function() {
                var editStars = document.querySelectorAll('#editStarRating .edit-star');
                var editRatingText = document.getElementById('editRatingText');
                editStars.forEach(function(star) {
                    star.addEventListener('mouseover', function() {
                        highlightEditStars(parseInt(this.getAttribute('data-rating')));
                    });
                    star.addEventListener('mouseout', function() {
                        highlightEditStars(_editRating);
                    });
                    star.addEventListener('click', function() {
                        _editRating = parseInt(this.getAttribute('data-rating'));
                        highlightEditStars(_editRating);
                        if (editRatingText) editRatingText.innerText = '(' + _editRating + ' sao)';
                    });
                });

                // Close modal on Escape
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        var modal = document.getElementById('editCommentModal');
                        if (modal) modal.style.display = 'none';
                    }
                });
            });

            function highlightEditStars(r) {
                var editStars = document.querySelectorAll('#editStarRating .edit-star');
                var editRatingText = document.getElementById('editRatingText');
                editStars.forEach(function(star, idx) {
                    star.style.color = '#f5c518';
                    star.style.opacity = (idx < r) ? '1' : '0.3';
                });
                if (editRatingText) editRatingText.innerText = '(' + r + ' sao)';
            }

            // Toast helper
            function showCommentToast(type, html) {
                var t = document.createElement('div');
                t.className = 'comment-toast ' + type;
                t.innerHTML = html;
                document.body.appendChild(t);
                setTimeout(function() {
                    t.style.opacity = '0';
                    t.style.transition = 'opacity 0.4s';
                    setTimeout(function() { t.remove(); }, 400);
                }, 2800);
            }

            // Reply functionality
            function toggleReplyBox(commentId, parentId, targetUserId, targetUserName, btnEl) {
                var isAuth = '@(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false")';
                if (isAuth !== 'true') {
                    alert('Vui lòng đăng nhập để trả lời bình luận.');
                    return;
                }

                var box = document.getElementById('reply-box-' + commentId);
                if (!box) return;

                if (box.style.display === 'none' || !box.style.display) {
                    document.querySelectorAll('.inline-reply-box').forEach(function(b) { b.style.display = 'none'; });
                    box.style.display = 'block';
                    var txt = document.getElementById('replyText-' + commentId);
                    if (txt) txt.focus();
                } else {
                    box.style.display = 'none';
                }
            }

            function closeReplyBox(commentId) {
                var box = document.getElementById('reply-box-' + commentId);
                if (box) box.style.display = 'none';
            }

            function postCommentReply(movieId, parentId, targetUserId, targetUserName, commentId) {
                var input = document.getElementById('replyText-' + commentId);
                var txt = input ? input.value.trim() : '';
                if (!txt) {
                    alert('Vui lòng nhập nội dung trả lời.');
                    return;
                }

                fetch('/api/comments/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        movieId: movieId,
                        rating: 5,
                        content: txt,
                        parentId: parentId,
                        replyToUserId: targetUserId,
                        replyToUserName: targetUserName
                    })
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success && data.comment) {
                        closeReplyBox(commentId);
                        if (input) input.value = '';
                        showCommentToast('success', '<i class="fas fa-check-circle text-success fs-5"></i> Đã gửi câu trả lời thành công!');
                        setTimeout(function() { location.reload(); }, 600);
                    } else {
                        alert(data.message || 'Không thể gửi phản hồi.');
                    }
                })
                .catch(function(err) {
                    alert('Lỗi khi kết nối với máy chủ.');
                });
            }

            function toggleBookmark(movieId) {
                fetch('/api/bookmarks/toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ movieId: movieId })
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success) {
                        var btn = document.getElementById('btnBookmarkDetail');
                        var icon = document.getElementById('bookmarkIcon');
                        var text = document.getElementById('bookmarkText');
                        if (data.isBookmarked) {
                            if (btn) { btn.classList.remove('btn-glass-custom'); btn.classList.add('btn-warning-custom'); }
                            if (icon) { icon.className = 'fas fa-bookmark me-1.5'; }
                            if (text) text.innerText = 'Đã Lưu Phim';
                        } else {
                            if (btn) { btn.classList.remove('btn-warning-custom'); btn.classList.add('btn-glass-custom'); }
                            if (icon) { icon.className = 'far fa-bookmark me-1.5'; }
                            if (text) text.innerText = 'Lưu Phim';
                        }
                        if (typeof showCommentToast === 'function') {
                            showCommentToast('success', '<i class="fas fa-bookmark text-warning me-1"></i> ' + data.message);
                        } else {
                            alert(data.message);
                        }
                    } else {
                        if (typeof showCommentToast === 'function') {
                            showCommentToast('error', '<i class="fas fa-exclamation-circle text-danger me-1"></i> ' + data.message);
                        } else {
                            alert(data.message);
                        }
                    }
                })
                .catch(function() {
                    alert('Lỗi khi kết nối với máy chủ.');
                });
            }
            </script>
        </div>

        <!-- Sidebar Related Movies -->
        <div class="col-lg-4">
            <h3 class="section-title mb-3" style="font-size:1.3rem;">Phim Cùng Thể Loại</h3>
            <div class="d-flex flex-column gap-3">
                @foreach (var rel in relatedMovies)
                {
                    <a href="/phim/@rel.Id" class="search-result-item p-2" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-md);">
                        <img src="@rel.PosterUrl" class="search-result-img" style="width:65px; height:90px; border-radius:var(--radius-sm);" alt="@rel.Title" />
                        <div class="search-result-info">
                            <div class="search-result-title" style="font-size:0.95rem;">@rel.Title</div>
                            <div class="search-result-meta mb-1">@rel.OriginalTitle</div>
                            <div class="d-flex align-items-center gap-2" style="font-size:0.78rem;">
                                <span class="text-warning"><i class="fas fa-star"></i> @rel.Rating</span>
                                <span class="text-muted">• @rel.ReleaseYear</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

