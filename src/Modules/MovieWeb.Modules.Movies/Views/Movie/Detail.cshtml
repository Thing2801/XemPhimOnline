    }
    #notifyMovieModal .notify-input-field:focus {
        background: rgba(255,255,255,0.1);
        border-color: #f59e0b;
    }
</style>

<div id="notifyMovieModal" class="custom-modal-wrapper" onclick="if(event.target === this) closeNotifyModal();">
    <div class="custom-modal-box">
        <!-- Modal Header -->
        <div class="custom-modal-header">
            <div class="d-flex align-items-center gap-2">
                <div class="modal-header-icon text-warning" style="background: rgba(245, 158, 11, 0.15);">
                    <i class="fas fa-bell"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-white mb-0" style="font-size: 1.15rem;">Nhận Thông Báo Khởi Chiếu</h5>
                    <div class="text-muted small" style="font-size: 0.78rem;" id="notifyModalMovieTitle">@Model.Title</div>
                </div>
            </div>
            <button type="button" class="custom-modal-close" onclick="closeNotifyModal()" title="Đóng modal">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="custom-modal-body">
            <p class="text-muted small mb-3" style="line-height: 1.5;">
                Đăng ký nhận thông báo ngay khi phim chính thức công chiếu tại rạp. Chúng tôi sẽ gửi thông báo trực tiếp qua Email của bạn!
            </p>
            <form id="notifyForm" onsubmit="submitNotifyForm(event)">
                <div class="mb-3">
                    <label class="form-label text-white small fw-semibold mb-1">Họ và Tên</label>
                    <input type="text" id="notifyName" class="notify-input-field" placeholder="Nhập họ tên của bạn..." required
                           value="@(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "")" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-white small fw-semibold mb-1">Địa chỉ Email</label>
                    <input type="email" id="notifyEmail" class="notify-input-field" placeholder="example@domain.com" required
                           value="@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")" />
                </div>
                <div class="custom-modal-footer">
                    <button type="button" class="btn-custom btn-glass-custom px-3 py-2" onclick="closeNotifyModal()">Hủy</button>
                    <button type="submit" class="btn-custom btn-primary-custom px-4 py-2" id="btnSubmitNotify">
                        <i class="fas fa-paper-plane me-1.5"></i> Đăng Ký Nhận Tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
