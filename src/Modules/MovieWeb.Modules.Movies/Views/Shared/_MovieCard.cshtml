@model MovieWeb.Core.Models.Movie

<div class="movie-card">
    <div class="movie-poster-wrap position-relative">
        <img src="@Model.PosterUrl" class="movie-poster" alt="@Model.Title" loading="lazy" />
        @if (Model.Price > 0)
        {
            <div class="position-absolute top-0 start-0 m-2 px-2.5 py-1 rounded-pill text-dark fw-bold shadow-sm d-flex align-items-center gap-1"
                 style="background: linear-gradient(135deg, #f59e0b, #fbbf24); font-size: 0.78rem; z-index: 4; border: 1px solid rgba(255,255,255,0.6);">
                <i class="fas fa-ticket-alt"></i> @Model.FormattedPrice
            </div>
        }
        
        @{
            double displayRating = Model.Rating;
            if (displayRating > 5.0)
            {
                while (displayRating > 5.0) { displayRating /= 2.0; }
                displayRating = Math.Clamp(Math.Round(displayRating, 1), 1.0, 5.0);
            }
        }
        <div class="movie-badge-group">
            @if (displayRating > 0)
            {
                <span class="badge-pill badge-gold"><i class="fas fa-star"></i> @displayRating.ToString("0.0")</span>
            }
            else
            {
                <span class="badge-pill badge-glass text-muted" style="font-size:0.72rem; opacity:0.85;"><i class="far fa-star me-1"></i> Chưa đánh giá</span>
            }
            <span class="badge-pill badge-primary">@Model.Quality</span>
            @if (Model.IsSeries)
            {
                <span class="badge-pill badge-blue">Bộ</span>
            }
        </div>

        <div class="movie-play-overlay">
            <a href="/phim/@Model.Id" class="play-icon-btn" title="Xem ngay">
                <i class="fas fa-play"></i>
            </a>
        </div>
    </div>

    <div class="movie-info">
        <a href="/phim/@Model.Id">
            <h3 class="movie-title" title="@Model.Title">@Model.Title</h3>
        </a>
        <div class="movie-orig-title">@Model.OriginalTitle</div>

        <div class="movie-meta">
            <span><i class="far fa-calendar-alt"></i> @Model.ReleaseYear</span>
            <span class="movie-rating">@Model.EpisodeInfo</span>
        </div>
    </div>
</div>
