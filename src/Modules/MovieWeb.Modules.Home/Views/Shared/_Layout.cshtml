@using MovieWeb.Core.Services
@inject IMovieService MovieService

@{
    var genres = await MovieService.GetAllGenresAsync();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Xem phim trực tuyến") - MovieOnline</title>
    <meta name="description" content="Xem phim trực tuyến chất lượng cao 4K, Vietsub, Thuyết minh miễn phí với kho phim đa dạng Thể loại: Tình cảm, Ngôn tình, Kinh dị, Trinh thám, Hành động, Siêu anh hùng, Phim Chiếu Rạp." />
    
    <!-- FontAwesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/site.css?v=5" />
</head>
<body style="background-color: #181818; color: #ffffff;">

    <!-- Header & Responsive Navbar (Black Header Bar #000000) -->
    <header class="site-header" id="siteHeader" style="background-color: #000000; border-bottom: 1px solid rgba(255, 255, 255, 0.1); position: sticky; top: 0; z-index: 1000; padding: 10px 20px;">
        <div class="nav-container" style="display: flex; align-items: center; justify-content: space-between; max-width: 1400px; margin: 0 auto; gap: 15px; width: 100%;">
            <!-- Brand Logo -->
            <a href="/" class="brand-logo" id="headerLogo" style="display: flex; align-items: center; gap: 8px; text-decoration: none;">
                <img src="/image/Logo/logo.png" alt="MovieOnline Logo" style="height: 45px; width: auto; object-fit: contain;" />
            </a>

            <!-- Navigation Buttons (Trang chủ, Phim, Phim Chiếu Rạp, Thể loại dropdown) -->
            <ul class="nav-menu" id="mainNavMenu">
                <li>
                    <a href="/" class="nav-btn-link @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")" id="navHomeLink">
                        Trang chủ
                    </a>
                </li>
                <li>
                    <a href="/phim" class="nav-btn-link @(ViewData["ActivePage"]?.ToString() == "Movies" ? "active" : "")" id="navMoviesLink">
                        Phim
                    </a>
                </li>
                <li>
                    <a href="/phim-bo" class="nav-btn-link @(ViewData["ActivePage"]?.ToString() == "Series" ? "active" : "")" id="navSeriesLink">
                        Phim Bộ
                    </a>
                </li>
                <li>
                    <a href="/phim-chieu-rap" class="nav-btn-link @(ViewData["ActivePage"]?.ToString() == "Cinema" ? "active" : "")" id="navCinemaLink">
                        Phim Chiếu Rạp
                    </a>
                </li>
                <li>
                    <a href="/bang-xep-hang" class="nav-btn-link @(ViewData["ActivePage"]?.ToString() == "Rankings" ? "active" : "")" id="navRankingsLink">
                        Xếp hạng
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a href="/the-loai" class="nav-btn-link @(ViewData["ActivePage"]?.ToString() == "Genres" ? "active" : "")" id="navGenresDropdown">
                        Thể loại <i class="fas fa-chevron-down" style="font-size:0.75rem; margin-left:2px"></i>
                    </a>
                    <div class="dropdown-menu-custom">
                        <div class="dropdown-header-title">Danh sách Thể loại</div>
                        @foreach (var g in genres)
                        {
                            <a href="/phim?genre=@g.Id" class="dropdown-genre-item">
                                <i class="@g.IconClass" style="width:18px"></i>
                                <span>@g.Name</span>
                            </a>
                        }
                        <a href="/the-loai" class="dropdown-genre-item" style="grid-column: 1 / -1; border-top: 1px solid rgba(255,255,255,0.08); margin-top:0.3rem; padding-top:0.5rem; color:var(--primary); font-weight:700;">
                            <i class="fas fa-arrow-right" style="width:18px"></i>
                            <span>Xem tất cả thể loại</span>
                        </a>
                    </div>
                </li>
            </ul>

            <!-- Header Right Search Bar & User Auth -->
            <div class="header-actions" style="display: flex !important; align-items: center !important; gap: 15px !important; margin-left: auto;">
                <div class="search-box-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="search-input" id="headerSearchInput" placeholder="Tìm tên phim, diễn viên..." autocomplete="off" />
                    <div class="search-results-popup" id="headerSearchPopup"></div>
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="user-menu-wrapper position-relative">
                        <button class="btn-user-profile" id="userMenuBtn" type="button" onclick="toggleUserDropdown(event)" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25); color: #fff; padding: 6px 16px 6px 8px; border-radius: 30px; display: inline-flex; align-items: center; gap: 9px; cursor: pointer; font-size: 0.9rem; font-weight: 600; transition: all 0.25s ease;">
                            <img src="@(User.FindFirst("AvatarUrl")?.Value ?? "https://api.dicebear.com/7.x/avataaars/svg?seed=" + User.Identity.Name)" class="user-nav-avatar" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--primary);" alt="Avatar" />
                            <span class="user-nav-name">@(string.IsNullOrEmpty(User.Identity.Name) ? "Thành viên" : User.Identity.Name)</span>
                            <i class="fas fa-chevron-down ms-1" style="font-size:0.75rem; color:#aaa;"></i>
                        </button>
                        <div class="user-dropdown-popup" id="userDropdownPopup">
                            <div class="user-dropdown-header">
                                <img src="@(User.FindFirst("AvatarUrl")?.Value ?? "https://api.dicebear.com/7.x/avataaars/svg?seed=" + User.Identity.Name)" class="user-header-avatar" alt="Avatar" />
                                <div>
                                    <div class="fw-bold text-white" style="font-size:0.92rem;">@User.Identity.Name</div>
                                    <div class="text-muted small" style="font-size:0.78rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                </div>
                            </div>
                            <div class="user-dropdown-body">
                                <a href="/Account/Profile" class="user-dropdown-item">
                                    <i class="fas fa-user-circle me-2 text-danger"></i> Trang cá nhân
                                </a>
                                <a href="/phim-da-luu" class="user-dropdown-item">
                                    <i class="fas fa-bookmark me-2 text-warning"></i> Phim đã lưu
                                </a>
                                <a href="/phim-da-mua" class="user-dropdown-item">
                                    <i class="fas fa-shopping-bag me-2 text-success"></i> Phim đã mua
                                </a>
                                <div class="user-dropdown-divider"></div>
                                <a href="/Account/Logout" class="btn-logout-item" style="text-decoration: none;">
                                    <i class="fas fa-sign-out-alt me-2 text-danger"></i> Đăng xuất
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="auth-btn-group" style="display: flex !important; align-items: center !important; visibility: visible !important;">
                        <a href="/Account/Login" class="btn-nav-login" id="headerLoginBtn" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%) !important; border: none !important; color: #ffffff !important; padding: 7px 20px !important; border-radius: 20px !important; font-size: 0.86rem !important; font-weight: 700 !important; text-decoration: none !important; display: inline-flex !important; align-items: center !important; gap: 6px !important; white-space: nowrap !important; box-shadow: 0 4px 14px rgba(229, 9, 20, 0.45) !important;">
                            Đăng nhập
                        </a>
                    </div>
                }

                <button class="btn-mobile-toggle" id="mobileNavToggle" aria-label="Toggle navigation">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Body (Layout #181818) -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Trailer & Detail Video Modal -->
    <div class="modal-backdrop-custom" id="videoTrailerModal" onclick="if(event.target === this) closeTrailerModal()">
        <div class="modal-content-custom">
            <button class="modal-close-btn" onclick="closeTrailerModal()"><i class="fas fa-times"></i></button>
            <div class="video-responsive" style="position:relative; width:100%; aspect-ratio:16/9; background:#000;">
                <iframe id="trailerIframe" src="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width:100%; height:100%; border:0;"></iframe>
                <video id="trailerVideoPlayer" controls style="display:none; width:100%; height:100%; background:#000; object-fit:contain;"></video>
            </div>
            <div class="modal-body-detail">
                <h4 id="trailerMovieTitle" class="text-white mb-2" style="font-size:1.2rem; font-weight:700;">Trailer Phim</h4>
                <p class="text-muted" style="font-size:0.85rem">Đang phát trailer trực tiếp từ MovieOnline Server 4K.</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-content">
            <div class="footer-col">
                <a href="/" class="brand-logo mb-3" style="display: inline-block;">
                    <img src="/image/Logo/logo.png" alt="MovieOnline Logo" style="height: 50px; width: auto; object-fit: contain;" />
                </a>
                <p class="text-muted" style="font-size:0.88rem; max-width:320px;">
                    Xem phim trực tuyến chất lượng cao, cập nhật phim chiếu rạp mới nhất hoàn toàn miễn phí. Đa dạng thể loại Hành động, Ngôn tình, Kinh dị, Phim Hoạt Hình và Siêu Anh Hùng.
                </p>
            </div>
            <div class="footer-col">
                <h5>Thể loại Nổi Bật</h5>
                <ul class="footer-links">
                    <li><a href="/phim?genre=hanh-dong">Hành Động</a></li>
                    <li><a href="/phim?genre=ngon-tinh">Ngôn Tình</a></li>
                    <li><a href="/phim?genre=kinh-di">Kinh Dị</a></li>
                    <li><a href="/phim?genre=sieu-anh-hung">Siêu Anh Hùng</a></li>
                    <li><a href="/phim-chieu-rap">Phim Chiếu Rạp</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Khám Phá</h5>
                <ul class="footer-links">
                    <li><a href="/phim-chieu-rap">Phim Rạp Mới Nhất</a></li>
                    <li><a href="/phim?sort=top">Phim Đánh Giá Cao</a></li>
                    <li><a href="/phim?sort=popular">Phim Xem Nhiều</a></li>
                    <li><a href="/phim?series=true">Phim Bộ Cập Nhật</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Thông Tin</h5>
                <ul class="footer-links">
                    <li><a href="#">Giới thiệu</a></li>
                    <li><a href="#">Bản quyền & DMCA</a></li>
                    <li><a href="#">Điều khoản sử dụng</a></li>
                    <li><a href="#">Liên hệ quảng cáo</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 MovieOnline - Xem phim trực tuyến. Powered by ASP.NET Orchard Core.</p>
        </div>
    </footer>

    <style>
    .user-menu-wrapper {
        position: relative !important;
        z-index: 10000 !important;
    }
    .btn-user-profile:hover {
        background: rgba(255, 255, 255, 0.2) !important;
        border-color: rgba(255, 255, 255, 0.4) !important;
    }
    .user-dropdown-popup {
        position: absolute !important;
        top: calc(100% + 8px) !important;
        right: 0 !important;
        width: 230px !important;
        background: #1c1c1e !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        border-radius: 14px !important;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.95) !important;
        display: none;
        z-index: 99999 !important;
        overflow: hidden !important;
        backdrop-filter: blur(16px) !important;
    }
    .user-dropdown-popup.show {
        display: block !important;
    }
    .user-dropdown-header {
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .user-header-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        border: 1.5px solid #e50914;
    }
    .user-dropdown-body {
        padding: 6px 0;
    }
    .user-dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 16px;
        color: #e0e0e0;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease;
    }
    .user-dropdown-item:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }
    .user-dropdown-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.08);
        margin: 6px 0;
    }
    .btn-logout-item {
        width: 100%;
        background: transparent;
        border: none;
        color: #ff4d55;
        padding: 10px 16px;
        text-align: left;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: background 0.2s ease;
    }
    .btn-logout-item:hover {
        background: rgba(255, 77, 85, 0.12);
        color: #ff6b72;
    }
    </style>

    <script src="/js/site.js?v=6"></script>
    <script>
    function toggleUserDropdown(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        var popup = document.getElementById('userDropdownPopup');
        if (popup) {
            if (popup.style.display === 'block' || popup.classList.contains('show')) {
                popup.style.display = 'none';
                popup.classList.remove('show');
            } else {
                popup.style.display = 'block';
                popup.classList.add('show');
            }
        }
    }
    document.addEventListener('click', function(e) {
        var popup = document.getElementById('userDropdownPopup');
        var btn = document.getElementById('userMenuBtn');
        if (popup && (popup.style.display === 'block' || popup.classList.contains('show'))) {
            if (btn && !btn.contains(e.target) && !popup.contains(e.target)) {
                popup.style.display = 'none';
                popup.classList.remove('show');
            }
        }
    });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
