        <div class="section-header">
            <h2 class="section-title">Phim Cổ Trang & Khoa Học Viễn Tưởng</h2>
            <a href="/phim?genre=co-trang" class="btn-view-all">Xem thêm <i class="fas fa-arrow-right"></i></a>
