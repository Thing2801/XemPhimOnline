@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - Xem Phim Trực Tuyến";
    ViewData["ActivePage"] = "Home";
}

<!-- Hero Banner Slider -->
<section class="hero-slider-container">
    @for (int i = 0; i < Model.HeroMovies.Count; i++)
    {
        var movie = Model.HeroMovies[i];
        <div class="hero-slide @(i == 0 ? "active" : "")" data-index="@i">
            <img src="@movie.BannerUrl" class="hero-bg" alt="@movie.Title" />
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <div class="hero-text-side">
                    <div class="hero-badges">
                        <span class="badge-pill badge-primary">NỔI BẬT</span>
                        @{
                            double heroRating = movie.Rating;
                            while (heroRating > 5.0) { heroRating /= 2.0; }
                            heroRating = Math.Clamp(Math.Round(heroRating, 1), 1.0, 5.0);
                        }
                        @if (movie.IsComingSoon)
                        {
                            <span class="badge-pill badge-gold"><i class="fas fa-calendar-alt"></i> Sắp khởi chiếu</span>
                        }
                        else
                        {
                            <span class="badge-pill badge-gold"><i class="fas fa-star"></i> @heroRating.ToString("0.0")</span>
                        }
                        <span class="badge-pill badge-glass">@movie.Quality</span>
                        <span class="badge-pill badge-glass">@movie.AgeRating</span>
                        <span class="badge-pill badge-glass">@movie.ReleaseYear</span>
                    </div>

                    <h1 class="hero-title">@movie.Title</h1>
                    <div class="hero-orig-title">@movie.OriginalTitle</div>
                    <p class="hero-description">@movie.Description</p>

                    <div class="hero-actions">
                        <a href="/phim/@movie.Id" class="btn-custom btn-primary-custom">
                            <i class="fas fa-play"></i> Xem ngay
                        </a>
                        <button class="btn-custom btn-glass-custom" onclick="playTrailerModal('@movie.TrailerUrl', '@movie.Title')">
                            <i class="fas fa-film"></i> Xem Trailer
                        </button>
                    </div>
                </div>

                <div class="hero-poster-card">
                    <img src="@movie.PosterUrl" class="hero-poster-img" alt="@movie.Title" />
                </div>
            </div>
        </div>
    }

    <!-- Hero Slider Dots -->
    <div class="hero-dots-container">
        <div class="slider-dots">
            @for (int i = 0; i < Model.HeroMovies.Count; i++)
            {
                <span class="dot @(i == 0 ? "active" : "")" data-slide="@i"></span>
            }
        </div>
    </div>
</section>

<!-- Main Body Sections -->
<div class="main-wrapper">

    <!-- Quick Genre Cards Grid -->
    <section class="mb-5">
        <div class="section-header">
            <h2 class="section-title">Khám Phá Theo Thể Loại</h2>
        </div>
        <div class="genre-grid">
            @foreach (var g in Model.Genres)
            {
                <a href="/phim?genre=@g.Id" class="genre-card">
                    <i class="@g.IconClass genre-icon"></i>
                    <span class="genre-name">@g.Name</span>
                    <span class="genre-count">(@g.MovieCount)</span>
                </a>
            }
        </div>
    </section>

    <!-- Carousel 1: Phim Thịnh Hành & Mới Cập Nhật -->
    <section class="movie-carousel-wrapper">
        <div class="section-header">
            <h2 class="section-title">Phim Thịnh Hành & Đánh Giá Cao</h2>
        </div>
        <div class="movie-carousel-container">
            <button class="carousel-btn carousel-btn-prev" onclick="scrollCarousel('carouselTrending', 'left')" aria-label="Lùi">
                <i class="fas fa-chevron-left"></i>
            </button>
            <div class="movie-carousel" id="carouselTrending">
                @foreach (var movie in Model.TrendingMovies)
                {
                    @await Html.PartialAsync("_MovieCard", movie)
                }
            </div>
            <button class="carousel-btn carousel-btn-next" onclick="scrollCarousel('carouselTrending', 'right')" aria-label="Tới">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </section>

