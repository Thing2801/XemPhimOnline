@model MovieWeb.Modules.Cinema.Models.CinemaViewModel
@{
    ViewData["Title"] = "Phim Chiếu Rạp";
    ViewData["ActivePage"] = "Cinema";
}

<div class="main-wrapper" style="padding-top: 1.5rem; padding-bottom: 3rem;">
        <!-- Header & Navigation Tabs -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom-cinema">
            <div>
                <h2 class="cinema-section-heading mb-1">
                    <i class="fas fa-video text-danger me-2"></i> Danh Sách Phim Chiếu Rạp
                </h2>
                <p class="text-muted small mb-0">Cập nhật đầy đủ lịch chiếu, trailer và thông tin rạp phim trên toàn quốc.</p>
            </div>
            
            <div class="cinema-tabs-nav">
                <a href="/phim-chieu-rap?tab=now-showing&q=@Model.SearchKeyword&genre=@Model.SelectedGenre&country=@Model.SelectedCountry&sort=@Model.SortBy" 
                   class="cinema-tab-link @(Model.SelectedTab == "now-showing" ? "active" : "")">
                    <i class="fas fa-fire me-1.5 text-danger"></i> Đang Chiếu Rạp (@Model.NowShowingMovies.Count)
                </a>
                <a href="/phim-chieu-rap?tab=coming-soon&q=@Model.SearchKeyword&genre=@Model.SelectedGenre&country=@Model.SelectedCountry&sort=@Model.SortBy" 
                   class="cinema-tab-link @(Model.SelectedTab == "coming-soon" ? "active" : "")">
                    <i class="fas fa-calendar-alt me-1.5 text-warning"></i> Sắp Chiếu Rạp (@Model.ComingSoonMovies.Count)
                </a>
            </div>
        </div>

        <!-- Filter Bar Form -->
        <div class="filter-container mb-4">
            <form method="get" action="/phim-chieu-rap" id="cinemaFilterForm">
                <input type="hidden" name="tab" value="@Model.SelectedTab" />
                <div class="filter-grid">
                    <!-- Search Keyword -->
                    <div class="form-group-custom" style="position:relative">
                        <label class="form-label-custom">Từ khóa tìm kiếm</label>
                        <input type="text" name="q" id="cinemaFilterSearch" value="@Model.SearchKeyword"
                               class="form-input-custom"
                               placeholder="Nhập tên phim chiếu rạp..."
                               autocomplete="off" />
                    </div>

                    <!-- Genre Select -->
                    <div class="form-group-custom">
                        <label class="form-label-custom">Thể loại</label>
                        <select name="genre" class="form-select-custom" onchange="this.form.submit()">
                            <option value="all" selected="@(Model.SelectedGenre == "all")">-- Tất cả Thể loại --</option>
                            @foreach (var g in Model.Genres)
                            {
                                <option value="@g.Id" selected="@(Model.SelectedGenre == g.Id)">@g.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Country Select -->
                    <div class="form-group-custom">
                        <label class="form-label-custom">Quốc gia</label>
                        <select name="country" class="form-select-custom" onchange="this.form.submit()">
                            <option value="all" selected="@(Model.SelectedCountry == "all")">-- Tất cả Quốc gia --</option>
                            <option value="Việt Nam" selected="@(Model.SelectedCountry == "Việt Nam")">Việt Nam</option>
                            <option value="Âu Mỹ" selected="@(Model.SelectedCountry == "Âu Mỹ")">Âu Mỹ</option>
                            <option value="Trung Quốc" selected="@(Model.SelectedCountry == "Trung Quốc")">Trung Quốc</option>
                            <option value="Hàn Quốc" selected="@(Model.SelectedCountry == "Hàn Quốc")">Hàn Quốc</option>
                            <option value="Nhật Bản" selected="@(Model.SelectedCountry == "Nhật Bản")">Nhật Bản</option>
                        </select>
                    </div>

                    <!-- Sort By -->
                    <div class="form-group-custom">
                        <label class="form-label-custom">Sắp xếp</label>
                        <select name="sort" class="form-select-custom" onchange="this.form.submit()">
                            <option value="newest" selected="@(Model.SortBy == "newest")">Mới nhất</option>
                            <option value="popular" selected="@(Model.SortBy == "popular")">Xem nhiều nhất</option>
                            <option value="rating" selected="@(Model.SortBy == "rating")">Đánh giá cao nhất</option>
                            <option value="title" selected="@(Model.SortBy == "title")">Tên A-Z</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>

        <!-- Movies Display Grid -->
        @{
            var displayList = Model.SelectedTab == "coming-soon" ? Model.ComingSoonMovies : Model.NowShowingMovies;
        }

        @if (displayList.Any())
        {
            <div class="cinema-grid">
                @foreach (var movie in displayList)
                {
                    <div class="cinema-movie-card">
                        <div class="cinema-poster-box">
                            <img src="@movie.PosterUrl" alt="@movie.Title" class="cinema-poster" loading="lazy" />
                            @if (movie.Price > 0)
                            {
                                <div class="position-absolute top-0 start-0 m-2 px-2.5 py-1 rounded-pill text-dark fw-bold shadow-sm d-flex align-items-center gap-1"
                                     style="background: linear-gradient(135deg, #f59e0b, #fbbf24); font-size: 0.78rem; z-index: 4; border: 1px solid rgba(255,255,255,0.6);">
                                    <i class="fas fa-ticket-alt"></i> @movie.FormattedPrice
                                </div>
                            }
                            <div class="cinema-poster-overlay">
                                <button class="btn-play-trigger" onclick="playTrailerModal('@movie.TrailerUrl.Replace("'", "\\'")', '@movie.Title.Replace("'", "\\'")')" title="Xem Trailer">
                                    <i class="fas fa-play"></i>
                                </button>
                                <a href="/phim/@movie.Id" class="btn-detail-trigger">Xem Chi Tiết</a>
                            </div>
                             <span class="cinema-tag-badge"><i class="fas fa-ticket-alt me-1"></i> @(movie.IsComingSoon ? "SẮP CHIẾU" : "ĐANG CHIẾU")</span>
                             @{
                                 double cinemaRating = movie.Rating;
                                 if (cinemaRating > 5.0)
                                 {
                                     while (cinemaRating > 5.0) { cinemaRating /= 2.0; }
                                     cinemaRating = Math.Clamp(Math.Round(cinemaRating, 1), 1.0, 5.0);
                                 }
                             }
                             @if (cinemaRating > 0)
                             {
                                 <span class="cinema-rating-badge"><i class="fas fa-star me-1 text-warning"></i>@cinemaRating.ToString("0.0")</span>
                             }
                             else
                             {
                                 <span class="cinema-rating-badge text-muted" style="background:rgba(0,0,0,0.6); font-size:0.75rem;"><i class="far fa-star me-1"></i>Chưa đánh giá</span>
                             }
                            <span class="cinema-quality-badge">@movie.Quality</span>
                        </div>
                        <div class="cinema-info-box">
                            <h3 class="cinema-movie-title" title="@movie.Title">
                                <a href="/phim/@movie.Id">@movie.Title</a>
                            </h3>
                            <div class="cinema-movie-meta">
                                @if (movie.IsComingSoon && !string.IsNullOrWhiteSpace(movie.ComingShowDate))
                                {
                                    <span class="text-warning fw-semibold" title="Ngày khởi chiếu"><i class="far fa-calendar-alt me-1"></i>Khởi chiếu: @movie.ComingShowDate</span>
                                }
                                else
                                {
                                    <span><i class="far fa-calendar-alt me-1"></i>@movie.ReleaseYear</span>
                                    <span>•</span>
                                    <span><i class="far fa-clock me-1"></i>@movie.Duration</span>
                                }
                            </div>
                            <div class="cinema-movie-genres text-truncate" title="@string.Join(", ", movie.GenreNames)">
                                @string.Join(" • ", movie.GenreNames)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="cinema-empty-card text-center py-5 my-4">
                <div class="cinema-empty-icon mb-3">
                    <i class="fas fa-film text-danger" style="font-size: 3.5rem;"></i>
                </div>
                <h4 class="text-white mb-2 fw-bold">Chưa có phim chiếu rạp trong thể loại này</h4>
                <p class="text-muted mb-3">Vui lòng chọn thể loại khác hoặc thêm phim chiếu rạp mới trong Admin.</p>
                <a href="/phim-chieu-rap" class="btn-cinema-primary">Xem Tất Cả Phim Chiếu Rạp</a>
            </div>
        }
    </div>

<style>
/* Modern Cinema Page Layout Styling */
.cinema-page-wrapper {
    background-color: #121212;
    min-height: 90vh;
    color: #e0e0e0;
}

/* Spotlight Hero Banner */
.cinema-spotlight-banner {
    position: relative;
    padding: 90px 0 60px 0;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.cinema-spotlight-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center top;
    filter: brightness(0.4) blur(3px);
    transform: scale(1.05);
}

.cinema-spotlight-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0.4) 0%, rgba(18, 18, 18, 0.95) 85%, #121212 100%),
                linear-gradient(90deg, rgba(18, 18, 18, 0.9) 0%, rgba(18, 18, 18, 0.5) 60%, rgba(18, 18, 18, 0.2) 100%);
}

.z-index-2 {
    z-index: 2;
}

.cinema-live-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(229, 9, 20, 0.2);
    border: 1px solid rgba(229, 9, 20, 0.5);
    color: #ff333d;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    box-shadow: 0 0 15px rgba(229, 9, 20, 0.2);
}

.pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #ff0f1a;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 8px #ff0f1a;
    animation: pulseGlow 1.5s infinite;
}

@@keyframes pulseGlow {
    0% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.2); }
    100% { opacity: 0.4; transform: scale(0.9); }
}

.cinema-spotlight-title {
    font-size: 3rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    text-shadow: 0 4px 20px rgba(0,0,0,0.8);
    background: linear-gradient(135deg, #ffffff 0%, #d1d1d1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.cinema-spotlight-orig {
    font-size: 1.15rem;
    color: #a0a0a0;
    font-weight: 500;
}

.meta-pill {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    color: #ffffff;
    font-weight: 600;
}

.meta-pill.rating {
    background: rgba(245, 197, 24, 0.2);
    border-color: rgba(245, 197, 24, 0.4);
    color: #f5c518;
    font-weight: 700;
}

.meta-pill.quality {
    background: rgba(229, 9, 20, 0.25);
    border-color: rgba(229, 9, 20, 0.4);
    color: #ff4d55;
}

.cinema-spotlight-desc {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 720px;
    color: #b0b0b0 !important;
}

.btn-cinema-primary {
    background: linear-gradient(135deg, #e50914 0%, #b20710 100%);
    color: #ffffff;
    font-weight: 700;
    padding: 12px 28px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 6px 20px rgba(229, 9, 20, 0.4);
    display: inline-flex;
    align-items: center;
    text-decoration: none;
}

.btn-cinema-primary:hover {
    background: linear-gradient(135deg, #ff0f1a 0%, #d80712 100%);
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(229, 9, 20, 0.6);
}

.btn-cinema-glass {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
}

.btn-cinema-glass:hover {
    background: rgba(255, 255, 255, 0.22);
    color: #ffffff;
    transform: translateY(-2px);
}

/* Spotlight Poster Card */
.cinema-spotlight-card {
    position: relative;
    display: inline-block;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0,0,0,0.8);
    border: 2px solid rgba(255, 255, 255, 0.15);
    transition: transform 0.4s ease;
}

.cinema-spotlight-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: rgba(229, 9, 20, 0.6);
}

.cinema-poster-img {
    width: 270px;
    height: 380px;
    object-fit: cover;
    display: block;
}

/* Content Main Section */
.border-bottom-cinema {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.cinema-section-heading {
    font-size: 1.8rem;
    font-weight: 800;
    color: #ffffff;
}

.cinema-tabs-nav {
    display: inline-flex;
    background: #1e1e1e;
    padding: 5px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.cinema-tab-link {
    color: #888888;
    padding: 9px 20px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all 0.25s ease;
}

.cinema-tab-link.active, .cinema-tab-link:hover {
    background: #e50914;
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(229, 9, 20, 0.3);
}

/* Genre Filter Pills */
.cinema-genre-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.cinema-genre-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #aaaaaa;
    padding: 7px 16px;
    border-radius: 20px;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
}

.cinema-genre-pill.active, .cinema-genre-pill:hover {
    background: rgba(229, 9, 20, 0.2);
    border-color: rgba(229, 9, 20, 0.6);
    color: #ff333d;
}

/* Movie Grid Section */
.cinema-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.5rem;
}

.cinema-movie-card {
    background: #1a1a1a;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    display: flex;
    flex-direction: column;
}

.cinema-movie-card:hover {
    transform: translateY(-8px);
    border-color: rgba(229, 9, 20, 0.5);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7);
}

.cinema-poster-box {
    position: relative;
    padding-top: 145%;
    overflow: hidden;
}

.cinema-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.cinema-movie-card:hover .cinema-poster {
    transform: scale(1.08);
}

.cinema-poster-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(3px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.cinema-movie-card:hover .cinema-poster-overlay {
    opacity: 1;
}

.btn-play-trigger {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #e50914;
    color: #ffffff;
    border: none;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(229, 9, 20, 0.6);
    transition: transform 0.25s ease;
}

.btn-play-trigger:hover {
    transform: scale(1.15);
}

.btn-detail-trigger {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 6px 18px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
}

.btn-detail-trigger:hover {
    background: #ffffff;
    color: #121212;
}

.cinema-tag-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: linear-gradient(135deg, #e50914 0%, #b20710 100%);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.5);
}

.cinema-rating-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 6px;
}

.cinema-quality-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(229, 9, 20, 0.85);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 4px;
}

.cinema-info-box {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.cinema-movie-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 6px;
    line-height: 1.3;
}

.cinema-movie-title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
}

.cinema-movie-title a:hover {
    color: #ff333d;
}

.cinema-movie-meta {
    font-size: 0.82rem;
    color: #888888;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
}

.cinema-movie-genres {
    font-size: 0.78rem;
    color: #e50914;
    font-weight: 600;
}

/* Empty State Card */
.cinema-empty-card {
    background: #1a1a1a;
    border-radius: 16px;
    border: 1px dashed rgba(255, 255, 255, 0.15);
}
</style>
